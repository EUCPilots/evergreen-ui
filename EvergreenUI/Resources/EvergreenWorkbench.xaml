<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        x:Name="MainWindow"
        Title="Workbench"
        Width="1200"
        Height="820"
        MinWidth="960"
        MinHeight="660"
        WindowStartupLocation="CenterScreen"
        ThemeMode="System"
        Background="{DynamicResource ApplicationBackgroundBrush}">
    <Window.Resources>
        <Style x:Key="WorkbenchGridTextStyle"
               TargetType="{x:Type TextBlock}"
               BasedOn="{x:Static DataGridTextColumn.DefaultElementStyle}">
            <Setter Property="Margin" Value="8,4" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="PageTitleTextBlockStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="28" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="SectionHeadingTextBlockStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="FormLabelStyle" TargetType="{x:Type Label}"
               BasedOn="{StaticResource {x:Type Label}}">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style x:Key="ProviderTabItemStyle" TargetType="{x:Type TabItem}">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="20,8" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabItem}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="ProviderTabHeader" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="HeaderBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="4">
                                <StackPanel Orientation="Horizontal"
                                            Margin="{TemplateBinding Padding}"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                                    <TextBlock x:Name="HeaderIcon"
                                               Text="{TemplateBinding Tag}"
                                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                               FontSize="14"
                                               Foreground="{Binding Path=(TextElement.Foreground), ElementName=HeaderContent}"
                                               Margin="0,0,8,0"
                                               VerticalAlignment="Center"
                                               IsHitTestVisible="False" />
                                    <ContentPresenter x:Name="HeaderContent"
                                                      ContentSource="Header"
                                                      RecognizesAccessKey="True"
                                                      TextElement.Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                      TextElement.FontSize="14"
                                                      TextElement.FontWeight="SemiBold"
                                                      VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Tag" Value="{x:Null}">
                                <Setter TargetName="HeaderIcon" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                            <Trigger Property="Tag" Value="">
                                <Setter TargetName="HeaderIcon" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HeaderBorder" Property="Background"
                                        Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="HeaderContent" Property="TextElement.Foreground"
                                        Value="{DynamicResource TextFillColorPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="HeaderBorder" Property="BorderBrush"
                                        Value="{DynamicResource TextFillColorPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="HeaderContent" Property="TextElement.Foreground"
                                        Value="{DynamicResource TextFillColorDisabledBrush}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast)}" Value="True">
                                <Setter TargetName="HeaderContent" Property="TextElement.Foreground"
                                        Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" />
                            </DataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding Path=(SystemParameters.HighContrast)}" Value="True" />
                                    <Condition Binding="{Binding IsKeyboardFocused, RelativeSource={RelativeSource Self}}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="HeaderBorder" Property="BorderBrush"
                                        Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" />
                            </MultiDataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ProviderTabControlStyle" TargetType="{x:Type TabControl}">
            <Setter Property="ItemContainerStyle" Value="{StaticResource ProviderTabItemStyle}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabControl}">
                        <Grid KeyboardNavigation.TabNavigation="Local">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid x:Name="HeaderArea">
                                <TabPanel x:Name="HeaderPanel"
                                          IsItemsHost="True"
                                          HorizontalAlignment="Left"
                                          KeyboardNavigation.TabIndex="1"
                                          KeyboardNavigation.TabNavigation="Once"
                                          KeyboardNavigation.DirectionalNavigation="Contained" />
                                <Border x:Name="SelectedIndicator"
                                        Width="24"
                                        Height="3"
                                        CornerRadius="1.5"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Top"
                                        IsHitTestVisible="False"
                                        Visibility="Collapsed">
                                    <Border.RenderTransform>
                                        <TranslateTransform />
                                    </Border.RenderTransform>
                                    <Border.Style>
                                        <Style TargetType="{x:Type Border}">
                                            <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast)}" Value="True">
                                                    <Setter Property="Background"
                                                            Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                            </Grid>
                            <ContentPresenter x:Name="PART_SelectedContentHost"
                                              Grid.Row="1"
                                              Margin="0,8,0,0"
                                              ContentSource="SelectedContent"
                                              KeyboardNavigation.TabIndex="2"
                                              KeyboardNavigation.TabNavigation="Local"
                                              KeyboardNavigation.DirectionalNavigation="Contained"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="NavigationButtonStyle" TargetType="{x:Type RadioButton}">
            <Setter Property="GroupName" Value="MainNavigation" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="ToolTip" Value="{Binding Content, RelativeSource={RelativeSource Self}}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RadioButton}">
                        <Border x:Name="NavigationBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3" />
                                    <ColumnDefinition x:Name="NavigationIconColumn" Width="24" />
                                    <ColumnDefinition x:Name="NavigationLabelColumn" Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="NavigationIcon"
                                           Grid.Column="1"
                                           Text="{TemplateBinding Tag}"
                                           FontFamily="Segoe Fluent Icons"
                                           FontSize="16"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Margin="8,0,0,0"
                                           Opacity="0.8" />
                                <ContentPresenter x:Name="NavigationLabel"
                                                  Grid.Column="2"
                                                  Margin="12,0"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NavigationBorder"
                                        Property="Background"
                                        Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="NavigationBorder"
                                        Property="Background"
                                        Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="NavigationBorder"
                                        Property="Background"
                                        Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType={x:Type ScrollViewer}}}"
                                         Value="True">
                                <Setter TargetName="NavigationLabel" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="NavigationIcon" Property="Grid.Column" Value="0" />
                                <Setter TargetName="NavigationIcon" Property="Grid.ColumnSpan" Value="2" />
                                <Setter TargetName="NavigationIcon" Property="Margin" Value="0" />
                                <Setter TargetName="NavigationIconColumn" Property="Width" Value="*" />
                                <Setter TargetName="NavigationLabelColumn" Property="Width" Value="Auto" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate x:Key="M365ConfigurationChipTemplate">
            <Border Margin="0,0,6,6" Padding="8,3" CornerRadius="4" Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                <TextBlock Text="{Binding}" />
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="M365ConfigurationMutedChipTemplate">
            <Border Margin="0,0,6,6" Padding="8,3" CornerRadius="4" BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                <TextBlock Text="{Binding}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </Border>
        </DataTemplate>
        <ItemsPanelTemplate x:Key="M365ConfigurationChipPanel">
            <WrapPanel />
        </ItemsPanelTemplate>
        <DataTemplate x:Key="M365ConfigurationRowTemplate">
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Label}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,8,0" />
                <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding Value}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Note}" Visibility="{Binding NoteVisibility}" FontSize="12" FontStyle="Italic" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="M365ConfigurationSummaryTemplate">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                <StackPanel>
                    <TextBlock Text="Configuration summary" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,8" />
                    <TextBlock Text="Select a configuration to see its contents." Visibility="{Binding EmptyVisibility}" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <Border Visibility="{Binding WarningVisibility}" Padding="10,8" Margin="0,0,0,12" CornerRadius="4" BorderThickness="1"
                            Background="{DynamicResource SystemFillColorCautionBackgroundBrush}" BorderBrush="{DynamicResource SystemFillColorCautionBrush}">
                        <TextBlock Text="{Binding WarningText}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                    </Border>
                    <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Description}" Visibility="{Binding DescriptionVisibility}" TextWrapping="Wrap" Margin="0,4,0,0" />
                    <TextBlock Text="{Binding FileName}" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0" />
                    <StackPanel Visibility="{Binding DetailsVisibility}" Margin="0,16,0,0">
                        <TextBlock Text="Included apps" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <ItemsControl ItemsSource="{Binding IncludedApps}" Visibility="{Binding IncludedVisibility}" Focusable="False"
                                      ItemsPanel="{StaticResource M365ConfigurationChipPanel}" ItemTemplate="{StaticResource M365ConfigurationChipTemplate}"
                                      AutomationProperties.Name="Included apps" />
                        <TextBlock Text="No apps from a Microsoft 365 Apps suite." Visibility="{Binding NoIncludedVisibility}" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,6" />
                        <StackPanel Visibility="{Binding ExcludedVisibility}" Margin="0,8,0,0">
                            <TextBlock Text="Excluded apps" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <ItemsControl ItemsSource="{Binding ExcludedApps}" Focusable="False"
                                          ItemsPanel="{StaticResource M365ConfigurationChipPanel}" ItemTemplate="{StaticResource M365ConfigurationMutedChipTemplate}"
                                          AutomationProperties.Name="Excluded apps" />
                        </StackPanel>
                        <StackPanel Visibility="{Binding AdditionalVisibility}" Margin="0,8,0,0">
                            <TextBlock Text="Additional products" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <ItemsControl ItemsSource="{Binding AdditionalProducts}" Focusable="False"
                                          ItemsPanel="{StaticResource M365ConfigurationChipPanel}" ItemTemplate="{StaticResource M365ConfigurationChipTemplate}"
                                          AutomationProperties.Name="Additional products" />
                        </StackPanel>
                        <TextBlock Text="Deployment" FontWeight="SemiBold" Margin="0,12,0,8" />
                        <ItemsControl ItemsSource="{Binding DeploymentRows}" Focusable="False" ItemTemplate="{StaticResource M365ConfigurationRowTemplate}"
                                      AutomationProperties.Name="Deployment settings" />
                        <TextBlock Text="Install behaviour" FontWeight="SemiBold" Margin="0,8,0,8" />
                        <ItemsControl ItemsSource="{Binding BehaviourRows}" Focusable="False" ItemTemplate="{StaticResource M365ConfigurationRowTemplate}"
                                      AutomationProperties.Name="Install behaviour" />
                        <TextBlock Text="{Binding UserSettingsText}" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </DataTemplate>
    </Window.Resources>
    <Grid x:Name="WorkbenchRoot" Grid.IsSharedSizeScope="True">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="NavigationColumn" Width="208" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border x:Name="NavigationPane"
                Grid.Column="0"
                Grid.RowSpan="2"
                Padding="16"
                BorderThickness="0,0,1,0"
                BorderBrush="{DynamicResource SubtleFillColorSecondaryBrush}">
            <DockPanel>
                <StackPanel x:Name="NavigationBrand" DockPanel.Dock="Top" Margin="4,8,4,20">
                    <TextBlock Text="Evergreen"
                               FontSize="20"
                               FontWeight="SemiBold" />
                    <TextBlock Text="Workbench"
                               FontSize="14"
                               Opacity="0.75" />
                </StackPanel>
                <Grid x:Name="NavigationItems">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ScrollViewer x:Name="NavigationScrollViewer"
                                  Grid.Row="0"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="NavigationItemsStack">
                            <RadioButton x:Name="NavApps"
                                         Style="{StaticResource NavigationButtonStyle}"
                                         Tag="&#xE71D;"
                                         AutomationProperties.Name="Apps view"
                                         ToolTip="Apps"
                                         IsChecked="True">
                                <DockPanel LastChildFill="True">
                                    <Border DockPanel.Dock="Right"
                                            x:Name="AppsQueueCountBadge"
                                            Background="{DynamicResource AccentFillColorDefaultBrush}"
                                            CornerRadius="8"
                                            Padding="8,4"
                                            Margin="8,0,0,0"
                                            Visibility="Collapsed">
                                        <TextBlock x:Name="AppsQueueCountText"
                                                   Text="0"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                                                   AutomationProperties.Name="Pending downloads" />
                                    </Border>
                                    <TextBlock Text="Apps" VerticalAlignment="Center" />
                                </DockPanel>
                            </RadioButton>
                            <RadioButton x:Name="NavLibrary"
                                         Style="{StaticResource NavigationButtonStyle}"
                                         Content="Library"
                                         Tag="&#xE8F1;"
                                         AutomationProperties.Name="Library view" />
                            <RadioButton x:Name="NavPackages"
                                         Style="{StaticResource NavigationButtonStyle}"
                                         Content="Packages"
                                         Tag="&#xE7B8;"
                                         AutomationProperties.Name="Packages view" />
                            <Border Height="1" Margin="8,12" Background="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            <RadioButton x:Name="NavIntune"
                                         Style="{StaticResource NavigationButtonStyle}"
                                         Content="Microsoft Intune"
                                         Tag="&#xE753;"
                                         AutomationProperties.Name="Microsoft Intune view" />
                            <RadioButton x:Name="NavNerdio"
                                         Style="{StaticResource NavigationButtonStyle}"
                                         Content="Nerdio Manager"
                                         Tag="&#xE968;"
                                         AutomationProperties.Name="Nerdio Manager view" />
                        </StackPanel>
                    </ScrollViewer>
                    <StackPanel x:Name="NavigationFooter"
                                Grid.Row="1">
                            <Border Height="1" Margin="8,12" Background="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            <RadioButton x:Name="NavSettings"
                                         Style="{StaticResource NavigationButtonStyle}"
                                         Content="Settings"
                                         Tag="&#xE713;"
                                         AutomationProperties.Name="Settings view" />
                            <RadioButton x:Name="NavAbout"
                                         Style="{StaticResource NavigationButtonStyle}"
                                         Content="About"
                                         Tag="&#xE946;"
                                         AutomationProperties.Name="About view" />
                    </StackPanel>
                    <Border x:Name="NavigationSelectionIndicator"
                            Grid.RowSpan="2"
                            Width="3"
                            Height="16"
                            Margin="1,0,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            CornerRadius="2"
                            IsHitTestVisible="False"
                            Visibility="Collapsed">
                        <Border.RenderTransform>
                            <TranslateTransform />
                        </Border.RenderTransform>
                        <Border.Style>
                            <Style TargetType="{x:Type Border}">
                                <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast)}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>
                </Grid>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" Grid.Row="0" Margin="20,16,20,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <DockPanel Grid.Row="0" Margin="0,0,0,16">
                <Border DockPanel.Dock="Right"
                        Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                        CornerRadius="8"
                        Padding="12,8"
                        VerticalAlignment="Center"
                        Margin="16,0,0,0">
                    <StackPanel>
                        <TextBlock Text="{Binding Tag, ElementName=StatusLabel}"
                                   FontWeight="SemiBold" FontSize="12" />
                        <TextBlock x:Name="StatusLabel"
                                   Text="Ready"
                                   Tag="Info"
                                   MaxWidth="800"
                                   TextWrapping="Wrap"
                                   LineStackingStrategy="BlockLineHeight"
                                   LineHeight="20"
                                   MaxHeight="40"
                                   TextTrimming="CharacterEllipsis"
                                   ClipToBounds="True"
                                   ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                                   AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>
                </Border>
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock x:Name="ViewTitleText"
                               Text="Apps"
                               Style="{StaticResource PageTitleTextBlockStyle}" />
                    <TextBlock x:Name="SubtitleTextBlock"
                               Text="Discover and download Evergreen applications"
                               Margin="0,4,0,0"
                               Opacity="0.75" />
                </StackPanel>
            </DockPanel>

            <Grid Grid.Row="1">
                <Grid x:Name="AppsPanel" Visibility="Visible">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="AppSearchBox"
                                 MinWidth="220"
                                 Height="32"
                                 VerticalContentAlignment="Center"
                                 Margin="0,0,12,0"
                                 ToolTip="Search the application catalog"
                                 AutomationProperties.Name="Search applications" />
                        <TextBlock x:Name="AppCountLabel"
                                   Grid.Column="1"
                                   Text="0 applications"
                                   VerticalAlignment="Center"
                                   Margin="0,0,12,0" />
                        <Button x:Name="EvergreenMenuButton"
                                Grid.Column="2"
                                Content="Actions..."
                                Padding="12,4"
                                ToolTip="Refresh the catalog or manage Evergreen data and the Workbench cache" />
                    </Grid>
                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="AppsListColumn" Width="220" MinWidth="160" />
                            <ColumnDefinition x:Name="AppsSplitterColumn" Width="8" />
                            <ColumnDefinition x:Name="ArtifactsColumn" Width="*" MinWidth="300" />
                        </Grid.ColumnDefinitions>
                        <DataGrid x:Name="AppsListView"
                                  Grid.Column="0"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  SelectionMode="Single"
                                  HeadersVisibility="None"
                                  CanUserAddRows="False"
                                  CanUserSortColumns="False"
                                  EnableRowVirtualization="True"
                                  AutomationProperties.Name="Application catalog">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Application"
                                                    Binding="{Binding FriendlyName}"
                                                    ElementStyle="{StaticResource WorkbenchGridTextStyle}"
                                                    Width="*" />
                                <DataGridTemplateColumn Header="Favourite" Width="72">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Tag="{Binding}"
                                                    FontFamily="Segoe Fluent Icons"
                                                    FontSize="16"
                                                    HorizontalAlignment="Center"
                                                    Padding="4,0"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    ToolTip="Toggle favourite"
                                                    AutomationProperties.Name="Toggle favourite">
                                                <Button.Style>
                                                    <Style TargetType="{x:Type Button}"
                                                           BasedOn="{StaticResource {x:Type Button}}">
                                                        <Setter Property="Content" Value="&#xE734;" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsFavourite}" Value="True">
                                                                <Setter Property="Content" Value="&#xE735;" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <GridSplitter x:Name="AppsListGridSplitter"
                                      Grid.Column="1"
                                      HorizontalAlignment="Stretch"
                                      VerticalAlignment="Stretch"
                                      ResizeDirection="Columns"
                                      ResizeBehavior="PreviousAndNext"
                                      Background="Transparent"
                                      ToolTip="Resize application list"
                                      AutomationProperties.Name="Resize application list" />
                        <Grid Grid.Column="2" Margin="4,0,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock x:Name="SelectedAppText"
                                       Grid.Row="0"
                                       Text="Select an application to view available versions"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,12" />
                            <Grid x:Name="ArtifactControlsGrid" Grid.Row="1" Margin="0,0,0,8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <!-- Match the filter controls' 120-pixel minimum width and 10-pixel margin. -->
                                <WrapPanel x:Name="ArtifactFiltersPanel" MinWidth="130" />
                                <WrapPanel x:Name="ArtifactActionsPanel"
                                           Grid.Column="1"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Bottom"
                                           Margin="0,0,0,6">
                                    <Button x:Name="ExportArtifactsButton"
                                            Content="Export to CSV"
                                            Margin="0,0,8,0"
                                            IsEnabled="{Binding HasItems, ElementName=ArtifactsGrid, FallbackValue=False}"
                                            ToolTip="Export displayed artifacts and visible columns to CSV"
                                            AutomationProperties.Name="Export artifacts to CSV" />
                                    <Button x:Name="ShowArtifactColumnsButton"
                                            Content="Columns"
                                            ToolTip="Show or hide artifact columns. Version and URI are always visible."
                                            AutomationProperties.Name="Show or hide artifact columns">
                                        <Button.ContextMenu>
                                            <ContextMenu Placement="Bottom" />
                                        </Button.ContextMenu>
                                    </Button>
                                </WrapPanel>
                            </Grid>
                            <DataGrid x:Name="ArtifactsGrid"
                                      Grid.Row="2"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      SelectionMode="Extended"
                                      SelectionUnit="FullRow"
                                      HeadersVisibility="Column"
                                      CanUserAddRows="False"
                                      EnableRowVirtualization="True"
                                      AutomationProperties.Name="Available application artifacts">
                                <DataGrid.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Copy URI" />
                                        <MenuItem Header="Open URI" />
                                    </ContextMenu>
                                </DataGrid.ContextMenu>
                            </DataGrid>
                        </Grid>
                        <Grid Grid.Row="1" Grid.ColumnSpan="3" Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="ArtifactCountLabel"
                                       Text="0 artifacts"
                                       VerticalAlignment="Center"
                                       Margin="0,0,12,0"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button x:Name="ClearCompletedQueueButton"
                                        Content="Clear completed"
                                        Padding="8,4"
                                        VerticalAlignment="Center"
                                        IsEnabled="False"
                                        AutomationProperties.HelpText="Remove downloaded and failed items from the queue" />
                                <Border x:Name="QueueActionsSeparator"
                                        Width="1"
                                        Margin="8,4"
                                        Background="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                <Button x:Name="ChangeDownloadPathButton"
                                        Content="Change destination"
                                        Padding="8,4"
                                        VerticalAlignment="Center"
                                        ToolTip="Change download destination"
                                        AutomationProperties.Name="Change destination" />
                                <Button x:Name="DownloadTrayActionButton"
                                        Content="Download"
                                        Style="{DynamicResource AccentButtonStyle}"
                                        Padding="8,4"
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center"
                                        IsEnabled="False" />
                                <Border x:Name="ArtifactActionsSeparator"
                                        Width="1"
                                        Margin="8,4"
                                        Background="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                <Button x:Name="QueueDownloadButton"
                                        Content="Add to queue"
                                        Style="{DynamicResource AccentButtonStyle}"
                                        Padding="8,4"
                                        FontWeight="SemiBold"
                                        VerticalAlignment="Center"
                                        IsEnabled="False" />
                                <Button x:Name="DownloadNowButton"
                                        Content="Download now"
                                        Margin="8,0,0,0"
                                        Padding="8,4"
                                        VerticalAlignment="Center"
                                        IsEnabled="False" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                    <GridSplitter x:Name="DownloadTrayGridSplitter"
                                  Grid.Row="2"
                                  Height="8"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Center"
                                  ResizeDirection="Rows"
                                  ResizeBehavior="PreviousAndNext"
                                  Background="Transparent"
                                  Visibility="Collapsed"
                                  ToolTip="Resize the download queue"
                                  AutomationProperties.Name="Resize the download queue" />
                    <Grid x:Name="DownloadTrayPanel"
                          Grid.Row="3"
                          Visibility="Collapsed"
                          Margin="0,4,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="DownloadDestinationText"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       Margin="0,0,12,0"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="Saved download folder" />
                            <ToggleButton x:Name="DownloadTrayToggleButton"
                                          Grid.Column="1"
                                          Content="Show queue"
                                          Padding="8,4"
                                          AutomationProperties.Name="Show or hide the download queue" />
                        </Grid>
                        <Grid x:Name="DownloadTrayContent"
                              Grid.Row="1"
                              Visibility="Collapsed">
                    <DataGrid x:Name="DownloadQueueListView"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              SelectionMode="Extended"
                              SelectionUnit="FullRow"
                              HeadersVisibility="Column"
                              CanUserAddRows="False"
                              EnableRowVirtualization="True"
                              AutomationProperties.Name="Download queue">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Application" Binding="{Binding AppName}" Width="2*" ElementStyle="{StaticResource WorkbenchGridTextStyle}" />
                            <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="110" ElementStyle="{StaticResource WorkbenchGridTextStyle}" />
                            <DataGridTextColumn Header="Architecture" Binding="{Binding Architecture}" Width="110" ElementStyle="{StaticResource WorkbenchGridTextStyle}" />
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="120" ElementStyle="{StaticResource WorkbenchGridTextStyle}" />
                            <DataGridTextColumn Header="URI" Binding="{Binding URI}" Width="3*" ElementStyle="{StaticResource WorkbenchGridTextStyle}" />
                            <DataGridTextColumn Header="Saved file" Binding="{Binding SavedPath}" Width="3*" ElementStyle="{StaticResource WorkbenchGridTextStyle}" />
                            <DataGridTemplateColumn Header="Actions" Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="x"
                                                    Tag="{Binding}"
                                                    Padding="8,4"
                                                    ToolTip="Remove this queued download"
                                                    AutomationProperties.Name="Remove queued download" />
                                            <Button Content="Open folder"
                                                    Tag="{Binding}"
                                                    Padding="8,4"
                                                    Margin="4,0,0,0"
                                                    ToolTip="Open the folder containing this download"
                                                    AutomationProperties.Name="Open downloaded file folder">
                                                <Button.Style>
                                                    <Style TargetType="{x:Type Button}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="Downloaded">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                        </Grid>
                    </Grid>
                </Grid>

                <Grid x:Name="LibraryPanel" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <!-- <StackPanel Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock Text="Evergreen library"
                                   Style="{StaticResource SectionHeadingTextBlockStyle}" />
                        <TextBlock Text="Read or update an initialized local Evergreen library."
                                   Margin="0,4,0,0"
                                   Opacity="0.75" />
                    </StackPanel> -->
                    <Grid Grid.Row="1" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Label Grid.Column="0" Content="Library location"
                               Target="{Binding ElementName=LibraryPathBox}"
                               VerticalAlignment="Center" Padding="0" Margin="0,0,12,0" />
                        <ComboBox x:Name="LibraryPathBox"
                                  Grid.Column="1"
                                  MinWidth="104"
                                  Height="32"
                                  IsEditable="True"
                                  IsTextSearchEnabled="False"
                                  VerticalContentAlignment="Center"
                                  AutomationProperties.Name="Library location"
                                  ToolTip="Folder containing EvergreenLibrary.json. Select a previously saved location from the list." />
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                            <Button x:Name="BrowseLibraryPathButton"
                                    Content="Browse"
                                    Margin="0,0,8,0"
                                    Padding="12,4" />
                            <Button x:Name="SetLibraryPathButton"
                                    Content="Save path"
                                    Margin="0,0,8,0"
                                    Padding="12,4" />
                            <Button x:Name="LoadLibraryButton"
                                    Content="Load"
                                    Margin="0,0,8,0"
                                    Padding="12,4" />
                            <Button x:Name="UpdateLibraryButton"
                                    Content="Update library"
                                    Style="{DynamicResource AccentButtonStyle}"
                                    Padding="12,4"
                                    FontWeight="SemiBold" />
                        </StackPanel>
                    </Grid>
                    <DataGrid x:Name="LibraryListView"
                              Grid.Row="2"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              HeadersVisibility="Column"
                              CanUserAddRows="False"
                              EnableRowVirtualization="True"
                              AutomationProperties.Name="Evergreen library inventory">
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Open folder" />
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Application" Binding="{Binding Name}" Width="2*" ElementStyle="{StaticResource WorkbenchGridTextStyle}" />
                            <DataGridTextColumn Header="Versions" Binding="{Binding VersionCount}" Width="110" ElementStyle="{StaticResource WorkbenchGridTextStyle}" />
                            <DataGridTextColumn Header="Location" Binding="{Binding Path}" Width="3*" ElementStyle="{StaticResource WorkbenchGridTextStyle}" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <Grid Grid.Row="3" Margin="0,12,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="LibraryDetailsText"
                                   Text="Select an application to view its library versions"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" Margin="0,0,12,0" />
                        <Button x:Name="RemoveLibraryAppButton"
                                Grid.Column="1"
                                Content="Remove application"
                                HorizontalAlignment="Right"
                                IsEnabled="False"
                                Padding="12,4"
                                ToolTip="Remove the selected application and its recorded installers from this library." />
                    </Grid>
                    <DataGrid x:Name="LibraryVersionsListView"
                              Grid.Row="4"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              SelectionMode="Extended"
                              SelectionUnit="FullRow"
                              HeadersVisibility="Column"
                              CanUserAddRows="False"
                              EnableRowVirtualization="True"
                              AutomationProperties.Name="Selected application library versions">
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Open folder" />
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="120" ElementStyle="{StaticResource WorkbenchGridTextStyle}" />
                            <DataGridTextColumn Header="Architecture" Binding="{Binding Architecture}" Width="130" ElementStyle="{StaticResource WorkbenchGridTextStyle}" />
                            <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="90" ElementStyle="{StaticResource WorkbenchGridTextStyle}" />
                            <DataGridTextColumn Header="Location" Binding="{Binding Location}" Width="2*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource WorkbenchGridTextStyle}">
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                        <Setter Property="ToolTip" Value="{Binding Location}" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="URI" Binding="{Binding URI}" Width="2*" ElementStyle="{StaticResource WorkbenchGridTextStyle}" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <Button x:Name="RemoveLibraryVersionsButton"
                            Grid.Row="5"
                            Content="Remove versions"
                            HorizontalAlignment="Right"
                            Margin="0,12,0,0"
                            Padding="12,4"
                            IsEnabled="False"
                            ToolTip="Remove only the selected artifact rows. Use Ctrl or Shift to select multiple rows." />
                </Grid>

                <Grid x:Name="PackagesPanel" Visibility="Collapsed">
                    <TabControl x:Name="PackagesTabControl" SelectedIndex="0"
                                Style="{StaticResource ProviderTabControlStyle}"
                                AutomationProperties.Name="Package workflows">
                        <TabItem x:Name="DefinitionsTab" Header="Definitions" Tag="&#xE8A5;">
                    <Grid Margin="0,0,0,8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Label Grid.Row="2" Content="Definitions folder" Target="{Binding ElementName=IntuneDefinitionsPathBox}"
                               Padding="0" Margin="0,0,0,4" />
                        <Grid Grid.Row="3" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="IntuneDefinitionsPathBox"
                                     MinWidth="104"
                                     Height="32"
                                     VerticalContentAlignment="Center"
                                     ToolTip="Folder containing Intune App.json definitions" />
                            <Button x:Name="BrowseIntuneDefinitionsButton"
                                    Grid.Column="1"
                                    Content="Browse"
                                    Margin="8,0,0,0"
                                    Padding="12,4" />
                            <Button x:Name="SaveIntuneDefinitionsPathButton"
                                    Grid.Column="2"
                                    Content="Save path"
                                    Margin="8,0,0,0"
                                    Padding="12,4" />
                            <Button x:Name="LoadPackageDefinitionsButton"
                                    Grid.Column="3"
                                    Content="Reload definitions"
                                    Margin="8,0,0,0"
                                    Padding="12,4" />
                            <Button x:Name="UpdatePackageDefinitionsButton"
                                    Grid.Column="4"
                                    Content="Update definitions"
                                    Style="{DynamicResource AccentButtonStyle}"
                                    Margin="8,0,0,0"
                                    Padding="12,4" />
                        </Grid>
                        <TextBlock x:Name="PackageDefinitionsCountLabel"
                                   Grid.Row="4"
                                   Text="0 definitions"
                                   Margin="0,0,0,12"
                                   VerticalAlignment="Center" />
                        <Grid Grid.Row="5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" MinWidth="200" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" MinWidth="200" />
                            </Grid.ColumnDefinitions>
                            <DataGrid x:Name="PackageDefinitionsListView"
                                      MinHeight="160"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      SelectionMode="Single"
                                      HeadersVisibility="Column"
                                      CanUserAddRows="False"
                                      EnableRowVirtualization="True"
                                      AutomationProperties.Name="Intune package definitions">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Application" Binding="{Binding Name}" Width="2*" ElementStyle="{StaticResource WorkbenchGridTextStyle}" />
                                    <DataGridTextColumn Header="Publisher" Binding="{Binding Publisher}" Width="*" ElementStyle="{StaticResource WorkbenchGridTextStyle}" />
                                    <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="130" ElementStyle="{StaticResource WorkbenchGridTextStyle}" />
                                    <DataGridTextColumn Header="Architecture" Binding="{Binding DefinitionObject.Application.Architecture}" Width="110" ElementStyle="{StaticResource WorkbenchGridTextStyle}" />
                                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="2*" ElementStyle="{StaticResource WorkbenchGridTextStyle}" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <GridSplitter Grid.Column="1"
                                          HorizontalAlignment="Stretch"
                                          VerticalAlignment="Stretch"
                                          ResizeDirection="Columns"
                                          ResizeBehavior="PreviousAndNext"
                                          Background="Transparent"
                                          ToolTip="Resize definition details"
                                          AutomationProperties.Name="Resize definition details" />
                            <DockPanel Grid.Column="2" Margin="4,0,0,0">
                                <TextBlock DockPanel.Dock="Top"
                                           Text="Definition details"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,12" />
                                <RichTextBox x:Name="PackageDefinitionDetailsText"
                                             IsReadOnly="True"
                                             VerticalScrollBarVisibility="Auto"
                                             HorizontalScrollBarVisibility="Disabled"
                                             AutomationProperties.Name="Selected definition details">
                                    <FlowDocument PagePadding="0"
                                                  FontFamily="{Binding FontFamily, ElementName=PackageDefinitionDetailsText}"
                                                  FontSize="{Binding FontSize, ElementName=PackageDefinitionDetailsText}">
                                        <Paragraph Margin="0">Select a definition to view its details.</Paragraph>
                                    </FlowDocument>
                                </RichTextBox>
                            </DockPanel>
                        </Grid>
                        <Label Grid.Row="6" Content="Package output folder" Target="{Binding ElementName=PackageOutputPathBox}"
                               Padding="0" Margin="0,16,0,4" />
                        <Grid Grid.Row="7">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="PackageOutputPathBox"
                                     MinWidth="104"
                                     Height="32"
                                     VerticalContentAlignment="Center"
                                     ToolTip="Default output folder for future Intune package builds" />
                            <Button x:Name="BrowsePackageOutputPathButton"
                                    Grid.Column="1"
                                    Content="Browse"
                                    Margin="8,0,0,0"
                                    Padding="12,4" />
                            <Button x:Name="SavePackageOutputPathButton"
                                    Grid.Column="2"
                                    Content="Save path"
                                    Margin="8,0,0,0"
                                    Padding="12,4" />
                        </Grid>
                    </Grid>
                        </TabItem>
                        <TabItem x:Name="InstallTab" Header="Install" Tag="&#xE896;">
                            <Grid x:Name="InstallPanel">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0" Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="InstallDefinitionsCountLabel"
                                               Text="0 definitions"
                                               VerticalAlignment="Center" />
                                    <CheckBox x:Name="HideIncompatibleInstallToggle"
                                              Grid.Column="1"
                                              Content="Hide incompatible"
                                              Margin="16,0,0,0"
                                              VerticalAlignment="Center"
                                              IsChecked="False" />
                                </Grid>
                                <DataGrid x:Name="InstallDefinitionsListView"
                                          Grid.Row="1"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          SelectionMode="Extended"
                                          SelectionUnit="FullRow"
                                          HeadersVisibility="Column"
                                          CanUserAddRows="False"
                                          EnableRowVirtualization="True"
                                          AutomationProperties.Name="Local install definitions">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Application" Binding="{Binding Name}" Width="2*" ElementStyle="{StaticResource WorkbenchGridTextStyle}" />
                                        <DataGridTextColumn Header="Required architecture" Binding="{Binding RequirementArchitecture}" Width="130" ElementStyle="{StaticResource WorkbenchGridTextStyle}" />
                                        <DataGridTextColumn Header="Artifact architecture" Binding="{Binding ArtifactArchitecture}" Width="130" ElementStyle="{StaticResource WorkbenchGridTextStyle}" />
                                        <DataGridTextColumn Header="Architecture status" Binding="{Binding ArchitectureStatus}" Width="150">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource WorkbenchGridTextStyle}">
                                                    <Setter Property="ToolTip" Value="{Binding ArchitectureError}" />
                                                    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="Publisher" Binding="{Binding Publisher}" Width="*" ElementStyle="{StaticResource WorkbenchGridTextStyle}" />
                                        <DataGridTextColumn Header="Installed" Binding="{Binding InstalledVersion}" Width="120" ElementStyle="{StaticResource WorkbenchGridTextStyle}" />
                                        <DataGridTextColumn Header="Latest" Binding="{Binding LatestVersion}" Width="120" ElementStyle="{StaticResource WorkbenchGridTextStyle}" />
                                        <DataGridTextColumn Header="Status" Binding="{Binding InstallStatus}" Width="2*" ElementStyle="{StaticResource WorkbenchGridTextStyle}" />
                                    </DataGrid.Columns>
                                </DataGrid>
                                <DockPanel Grid.Row="2" Margin="0,12,0,0">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <Button x:Name="ReloadInstallDefinitionsButton"
                                                Content="Reload definitions"
                                                Margin="0,0,8,0"
                                                Padding="12,4" />
                                        <Button x:Name="ResolveInstallVersionsButton"
                                                Content="Find latest versions"
                                                Margin="0,0,8,0"
                                                Padding="12,4"
                                                IsEnabled="False" />
                                        <Button x:Name="InstallSelectedPackagesButton"
                                                Content="Install selected"
                                                Style="{DynamicResource AccentButtonStyle}"
                                                Padding="12,4"
                                                FontWeight="SemiBold"
                                                IsEnabled="False" />
                                    </StackPanel>
                                    <TextBlock Text="Latest-version lookup uses the Evergreen catalog."
                                               VerticalAlignment="Center"
                                               Opacity="0.75" />
                                </DockPanel>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </Grid>

                <Grid x:Name="IntunePanel" Visibility="Collapsed">
                    <TabControl x:Name="IntuneTabControl" Style="{StaticResource ProviderTabControlStyle}">
                        <TabItem Header="Win32 apps" Tag="&#xECAA;">
                            <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid x:Name="IntuneConnectionToolbar" Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="IntuneConnectionStatusLabel" Text="Not connected"
                                   VerticalAlignment="Center" MaxWidth="220" Margin="0,0,12,0"
                                   TextWrapping="Wrap" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                        <!-- Reverse flow keeps wrapped action rows right-aligned. -->
                        <WrapPanel Grid.Column="1" HorizontalAlignment="Right" FlowDirection="RightToLeft"
                                   KeyboardNavigation.TabNavigation="Local">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" FlowDirection="LeftToRight">
                                <Border x:Name="IntuneCompareActionsSeparator" Width="1" Margin="12,4"
                                        Background="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                <Button x:Name="CompareIntuneButton" Content="Compare definitions" Padding="12,4"
                                        KeyboardNavigation.TabIndex="3" />
                            </StackPanel>
                            <Button x:Name="ConnectIntuneButton" Content="Connect" Margin="0,0,12,0"
                                    Padding="12,4" VerticalAlignment="Center" FlowDirection="LeftToRight"
                                    KeyboardNavigation.TabIndex="2" />
                            <CheckBox x:Name="UseIntuneDeviceCodeToggle" Content="Device code"
                                      VerticalAlignment="Center" Margin="0,0,12,0" FlowDirection="LeftToRight"
                                      KeyboardNavigation.TabIndex="1" />
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" FlowDirection="LeftToRight">
                                <Label Content="Tenant ID (optional)" Target="{Binding ElementName=IntuneTenantIdBox}"
                                       VerticalAlignment="Center" Padding="0" Margin="0,0,12,0" />
                                <TextBox x:Name="IntuneTenantIdBox" Width="220" Height="32"
                                         VerticalContentAlignment="Center" AutomationProperties.Name="Intune tenant ID"
                                         KeyboardNavigation.TabIndex="0" />
                            </StackPanel>
                        </WrapPanel>
                    </Grid>
                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <DockPanel Margin="0,0,0,8">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Label x:Name="IntuneInventoryViewLabel" Content="View" Target="{Binding ElementName=IntuneInventoryViewCombo}" VerticalAlignment="Center" Padding="0" Margin="0,0,8,0" />
                                <ComboBox x:Name="IntuneInventoryViewCombo" SelectedIndex="0" Width="150" AutomationProperties.Name="Intune inventory view">
                                    <ComboBoxItem Content="Definitions" />
                                    <ComboBoxItem Content="Intune-only apps" />
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Label x:Name="IntuneDefinitionSearchLabel" Content="Search" Target="{Binding ElementName=IntuneDefinitionSearchBox}" VerticalAlignment="Center" Padding="0" Margin="0,0,8,0" />
                                <TextBox x:Name="IntuneDefinitionSearchBox" Width="190" VerticalContentAlignment="Center" AutomationProperties.Name="Search Intune definitions" />
                            </StackPanel>
                        </DockPanel>
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ListView x:Name="IntuneComparisonListView" SelectionMode="Single" Visibility="Collapsed"
                                      VirtualizingPanel.IsVirtualizing="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                      AutomationProperties.Name="Intune definitions">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem" BasedOn="{StaticResource {x:Type ListViewItem}}">
