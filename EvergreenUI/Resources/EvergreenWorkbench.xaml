                            </ScrollViewer>
                        </TabItem>
                    </TabControl>
                </Grid>

                <Grid x:Name="InstallPanel" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="InstallDefinitionsCountLabel"
                                   Text="0 definitions"
                                   VerticalAlignment="Center" />
                        <CheckBox x:Name="HideIncompatibleInstallToggle"
                                  Grid.Column="1"
                                  Content="Hide incompatible"
                                  Margin="18,0,0,0"
                                  VerticalAlignment="Center"
                                  IsChecked="False" />
                        <TextBlock x:Name="InstallActionStatusLabel"
                                   Grid.Column="2"
                                   Text="Reload definitions to check local installation status."
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Right"
                                   TextWrapping="Wrap"
                                   Opacity="0.75" />
                    </Grid>
                    <DataGrid x:Name="InstallDefinitionsListView"
                              Grid.Row="1"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              SelectionMode="Extended"
                              SelectionUnit="FullRow"
                              HeadersVisibility="Column"
                              CanUserAddRows="False"
                              EnableRowVirtualization="True"
                              AutomationProperties.Name="Local install definitions">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Application" Binding="{Binding Name}" Width="2*" ElementStyle="{StaticResource WorkbenchGridTextStyle}" />
                            <DataGridTextColumn Header="Required architecture" Binding="{Binding RequirementArchitecture}" Width="130" ElementStyle="{StaticResource WorkbenchGridTextStyle}" />
                            <DataGridTextColumn Header="Artifact architecture" Binding="{Binding ArtifactArchitecture}" Width="130" ElementStyle="{StaticResource WorkbenchGridTextStyle}" />
                            <DataGridTextColumn Header="Architecture status" Binding="{Binding ArchitectureStatus}" Width="150">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource WorkbenchGridTextStyle}">
                                        <Setter Property="ToolTip" Value="{Binding ArchitectureError}" />
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Publisher" Binding="{Binding Publisher}" Width="*" ElementStyle="{StaticResource WorkbenchGridTextStyle}" />
                            <DataGridTextColumn Header="Installed" Binding="{Binding InstalledVersion}" Width="120" ElementStyle="{StaticResource WorkbenchGridTextStyle}" />
                            <DataGridTextColumn Header="Latest" Binding="{Binding LatestVersion}" Width="120" ElementStyle="{StaticResource WorkbenchGridTextStyle}" />
                            <DataGridTextColumn Header="Status" Binding="{Binding InstallStatus}" Width="2*" ElementStyle="{StaticResource WorkbenchGridTextStyle}" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <DockPanel Grid.Row="2" Margin="0,12,0,0">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button x:Name="ReloadInstallDefinitionsButton"
                                    Content="Reload definitions"
                                    Margin="0,0,8,0"
                                    Padding="12,5" />
                            <Button x:Name="ResolveInstallVersionsButton"
                                    Content="Find latest versions"
                                    Margin="0,0,8,0"
                                    Padding="12,5"
                                    IsEnabled="False" />
                            <Button x:Name="InstallSelectedPackagesButton"
                                    Content="Install selected"
                                    Style="{DynamicResource AccentButtonStyle}"
                                    Padding="14,5"
                                    FontWeight="SemiBold"
                                    IsEnabled="False" />
                        </StackPanel>
                        <TextBlock Text="Latest-version lookup uses the Evergreen catalog."
                                   VerticalAlignment="Center"
                                   Opacity="0.75" />
                    </DockPanel>
                </Grid>

                <Grid x:Name="SettingsPanel" Visibility="Collapsed">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel MaxWidth="760" Margin="0,0,0,8">
                            <TextBlock Text="Appearance"
                                       Style="{StaticResource SectionHeadingTextBlockStyle}"
                                       Margin="0,0,0,8" />
                            <Label Content="Color theme" Target="{Binding ElementName=ThemeCombo}" Padding="0" Margin="0,0,0,5" />
                            <ComboBox x:Name="ThemeCombo"
                                      SelectedIndex="0"
                                      HorizontalAlignment="Left"
                                      MinWidth="180"
                                      Margin="0,0,0,24"
                                      ToolTip="Choose the Workbench color theme"
                                      AutomationProperties.Name="Color theme">
                                <sys:String>System</sys:String>
                                <sys:String>Light</sys:String>
                                <sys:String>Dark</sys:String>
                            </ComboBox>
                            <TextBlock Text="Saved folders"
                                       Style="{StaticResource SectionHeadingTextBlockStyle}"
                                       Margin="0,0,0,8" />
                            <TextBlock Text="Use Browse to change a saved folder. The Library view also has its own path controls."
                                       TextWrapping="Wrap"
                                       Opacity="0.75"
                                       Margin="0,0,0,16" />
                            <Label Content="Download folder" Target="{Binding ElementName=SettingsDownloadPathBox}" Padding="0" Margin="0,0,0,5" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="SettingsDownloadPathBox"
                                         IsReadOnly="True"
                                         Height="32"
                                         VerticalContentAlignment="Center"
                                         AutomationProperties.Name="Saved download folder" />
                                <Button x:Name="BrowseDownloadFolderButton"
                                        Grid.Column="1"
                                        Content="Browse"
                                        Margin="8,0,0,0"
                                        Padding="12,4"
                                        AutomationProperties.Name="Browse for download folder" />
                                <Button x:Name="OpenDownloadFolderButton"
                                        Grid.Column="2"
                                        Content="Open folder"
                                        Margin="8,0,0,0"
                                        Padding="12,4"
                                        IsEnabled="False"
                                        AutomationProperties.Name="Open download folder" />
                            </Grid>
                            <TextBlock x:Name="DownloadFolderStatusLabel"
                                       Text="Folder has not been checked."
                                       TextWrapping="Wrap"
                                       Opacity="0.75"
                                       Margin="0,5,0,16" />
                            <Label Content="Library folder" Target="{Binding ElementName=SettingsLibraryPathBox}" Padding="0" Margin="0,0,0,5" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="SettingsLibraryPathBox"
                                         IsReadOnly="True"
                                         Height="32"
                                         VerticalContentAlignment="Center"
                                         AutomationProperties.Name="Saved library folder" />
                                <Button x:Name="BrowseLibraryFolderButton"
                                        Grid.Column="1"
                                        Content="Browse"
                                        Margin="8,0,0,0"
                                        Padding="12,4"
                                        AutomationProperties.Name="Browse for library folder" />
                                <Button x:Name="OpenLibraryFolderButton"
                                        Grid.Column="2"
                                        Content="Open folder"
                                        Margin="8,0,0,0"
                                        Padding="12,4"
                                        IsEnabled="False"
                                        AutomationProperties.Name="Open library folder" />
                            </Grid>
                            <TextBlock x:Name="LibraryFolderStatusLabel"
                                       Text="Folder has not been checked."
                                       TextWrapping="Wrap"
                                       Opacity="0.75"
                                       Margin="0,5,0,0" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <Grid x:Name="AboutPanel" Visibility="Collapsed">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel MaxWidth="900" Margin="0,0,0,8">
                            <TextBlock x:Name="AboutNameValue"
                                       Style="{StaticResource SectionHeadingTextBlockStyle}"
                                       Margin="0,0,0,8" />
                            <TextBlock x:Name="AboutVersionValue" Margin="0,0,0,4" />
                            <TextBlock x:Name="AboutAuthorValue" Margin="0,0,0,4" />
                            <TextBlock x:Name="AboutCompanyValue" Margin="0,0,0,4" />
                            <TextBlock x:Name="AboutCopyrightValue"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,8" />
                            <TextBlock x:Name="AboutDescriptionValue"
                                       TextWrapping="Wrap"
                                       Opacity="0.75"
                                       Margin="0,0,0,8" />
                            <TextBlock Margin="0,0,0,18">
                                <Hyperlink x:Name="AboutProjectLink">Project website</Hyperlink>
                                <Run Text="    " />
                                <Hyperlink x:Name="AboutLicenseLink">License</Hyperlink>
                            </TextBlock>
                            <TextBlock x:Name="AboutLinkStatusLabel"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,8" />
                            <TextBlock Text="Dependencies"
                                       Style="{StaticResource SectionHeadingTextBlockStyle}"
                                       Margin="0,0,0,8" />
                            <TextBlock Text="Installed is the highest discoverable version. Loaded versions are for the Workbench window runspace; background Jobs and the caller can differ."
                                       TextWrapping="Wrap"
                                       Opacity="0.75"
                                       Margin="0,0,0,8" />
                            <DockPanel Margin="0,0,0,8">
                                <Button x:Name="RefreshAboutDependenciesButton"
                                        DockPanel.Dock="Right"
                                        Content="Refresh"
                                        Padding="12,4"
                                        AutomationProperties.Name="Refresh dependency status" />
                                <TextBlock x:Name="AboutDependencyStatusLabel"
                                           Text="Dependency status has not been checked."
                                           TextWrapping="Wrap"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0" />
                            </DockPanel>
                            <DataGrid x:Name="AboutDependenciesListView"
                                      Height="220"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      SelectionMode="Single"
                                      HeadersVisibility="Column"
                                      CanUserAddRows="False"
                                      EnableRowVirtualization="True"
                                      AutomationProperties.Name="Workbench dependency status">
                                <DataGrid.Resources>
                                    <Style x:Key="DependencyCellStyle" TargetType="{x:Type TextBlock}"
                                           BasedOn="{StaticResource WorkbenchGridTextStyle}">
                                        <Setter Property="TextWrapping" Value="Wrap" />
                                    </Style>
                                </DataGrid.Resources>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Module" Binding="{Binding Name}"
                                                        Width="150" ElementStyle="{StaticResource DependencyCellStyle}" />
                                    <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="80" ElementStyle="{StaticResource WorkbenchGridTextStyle}" />
                                    <DataGridTextColumn Header="Installed" Binding="{Binding InstalledVersion}" Width="110" ElementStyle="{StaticResource WorkbenchGridTextStyle}" />
                                    <DataGridTextColumn Header="Loaded (window)" Binding="{Binding LoadedVersions}"
                                                        Width="150" ElementStyle="{StaticResource DependencyCellStyle}" />
                                    <DataGridTextColumn Header="Minimum" Binding="{Binding MinimumVersion}" Width="100" ElementStyle="{StaticResource WorkbenchGridTextStyle}" />
                                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="120" ElementStyle="{StaticResource WorkbenchGridTextStyle}" />
                                    <DataGridTextColumn Header="Purpose" Binding="{Binding Purpose}"
                                                        Width="220" ElementStyle="{StaticResource DependencyCellStyle}" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>

            <DockPanel Grid.Row="2" Margin="0,12,0,0">
                <TextBlock x:Name="AppsMaintenanceStatusLabel"
                           DockPanel.Dock="Top"
                           Text="Maintenance ready"
                           TextWrapping="Wrap"
                           Visibility="{Binding Visibility, ElementName=AppsPanel}"
                           Margin="0,0,0,6" />
                <ProgressBar x:Name="JobProgressBar"
                             Height="6"
                             Minimum="0"
                             Maximum="100"
                             Value="0"
                             Visibility="Collapsed" />
            </DockPanel>
        </Grid>

        <Expander Grid.Column="1"
                  Grid.Row="1"
                  Header="Activity log"
                  IsExpanded="False"
                  Margin="24,0,24,12">
            <StackPanel>
                <Thumb x:Name="ActivityLogResizeThumb"
                       Height="8"
                       Cursor="SizeNS"
                       Focusable="True"
                       ToolTip="Drag or use the up and down arrow keys to resize the activity log"
                       AutomationProperties.Name="Resize activity log" />
                <TextBox x:Name="ActivityLog"
                     Height="140"
                     IsReadOnly="True"
                     AcceptsReturn="True"
                     TextWrapping="NoWrap"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"
                     FontFamily="Consolas"
                     FontSize="12"
                     AutomationProperties.Name="Workbench activity log" />
            </StackPanel>
        </Expander>
    </Grid>
</Window>
