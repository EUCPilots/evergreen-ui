                                                <WrapPanel>
                                                    <Button x:Name="NerdioM365BuildButton" Content="Build only" Padding="12,4" Margin="0,0,8,0" />
                                                    <Button x:Name="NerdioM365PublishButton" Content="Build and publish" Style="{DynamicResource AccentButtonStyle}" Padding="12,4" Margin="0,0,8,0" FontWeight="SemiBold" />
                                                    <Button x:Name="NerdioM365CancelButton" Content="Cancel" Padding="12,4" />
                                                </WrapPanel>
                                            </StackPanel>
                                        </GroupBox>
                                        <Expander Header="Nerdio recovery" IsExpanded="False" Margin="0,0,0,12">
                                            <StackPanel Margin="8">
                                                <TextBlock Text="Select an unresolved result. Acknowledging does not verify or cancel the Nerdio operation; a retry may conflict with it." TextWrapping="Wrap" Margin="0,0,0,8" />
                                                <DataGrid x:Name="NerdioM365RecoveryList" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" MaxHeight="180" AutomationProperties.Name="Nerdio recovery outcomes">
                                                    <DataGrid.Columns>
                                                        <DataGridTextColumn Header="App" Binding="{Binding Name}" Width="2*" ElementStyle="{StaticResource WorkbenchGridTextStyle}" />
                                                        <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="*" ElementStyle="{StaticResource WorkbenchGridTextStyle}" />
                                                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*" ElementStyle="{StaticResource WorkbenchGridTextStyle}" />
                                                        <DataGridTextColumn Header="Destination" Binding="{Binding Destination}" Width="2*" ElementStyle="{StaticResource WorkbenchGridTextStyle}" />
                                                        <DataGridTextColumn Header="Job ID" Binding="{Binding JobId}" Width="*" ElementStyle="{StaticResource WorkbenchGridTextStyle}" />
                                                    </DataGrid.Columns>
                                                </DataGrid>
                                                <Button x:Name="NerdioM365AcknowledgeButton" Content="Acknowledge unknown" HorizontalAlignment="Left" Padding="12,4" Margin="0,8,0,0" IsEnabled="False" />
                                            </StackPanel>
                                        </Expander>
                                        <TextBlock x:Name="NerdioM365ResultText" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                            </ScrollViewer>
                            </DockPanel>
                        </TabItem>
                        <TabItem Header="Settings" Tag="&#xE713;">
                            <DockPanel>
                                <TextBlock x:Name="NerdioSettingsConnectionStatusLabel" DockPanel.Dock="Top"
                                           Text="{Binding ElementName=NerdioConnectionStatusLabel, Path=Text, Mode=OneWay}"
                                           TextWrapping="Wrap" Margin="0,0,0,8" />
                                <ScrollViewer x:Name="NerdioSetupScrollViewer" VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel>
                                        <Label Content="Tenant ID (Azure and Nerdio API)" Target="{Binding ElementName=NerdioTenantIdBox}" Padding="0" />
                                        <TextBox x:Name="NerdioTenantIdBox" AutomationProperties.Name="Azure and Nerdio tenant ID" Margin="0,4,0,8" />
                                        <Expander Header="Nerdio Manager API setup" IsExpanded="True" Margin="0,0,0,8">
                                            <StackPanel Margin="0,8">
                                                <Label Content="Nerdio HTTPS host" Target="{Binding ElementName=NmeHostBox}" Padding="0" />
                                                <TextBox x:Name="NmeHostBox" AutomationProperties.Name="Nerdio host" Margin="0,4,0,8" />
                                                <Label Content="Application client ID" Target="{Binding ElementName=NmeClientIdBox}" Padding="0" />
                                                <TextBox x:Name="NmeClientIdBox" AutomationProperties.Name="Nerdio client ID" Margin="0,4,0,8" />
                                                <Label Content="API scope" Target="{Binding ElementName=NmeApiScopeBox}" Padding="0" />
                                                <TextBox x:Name="NmeApiScopeBox" AutomationProperties.Name="Nerdio API scope" Margin="0,4,0,8" />
                                                <Label Content="OAuth token URL (optional)" Target="{Binding ElementName=NmeOAuthTokenUrlBox}" Padding="0" />
                                                <TextBox x:Name="NmeOAuthTokenUrlBox" AutomationProperties.Name="Nerdio OAuth token URL" Margin="0,4,0,8" />
                                                <Label Content="Client secret (not saved)" Target="{Binding ElementName=NmeClientSecretBox}" Padding="0" />
                                                <PasswordBox x:Name="NmeClientSecretBox" AutomationProperties.Name="Nerdio client secret" Margin="0,4,0,8" />
                                                <Button x:Name="ConnectNerdioButton" Content="Connect Nerdio Manager API" HorizontalAlignment="Left" Padding="12,4" />
                                            </StackPanel>
                                        </Expander>
                                        <Expander Header="Azure storage setup" IsExpanded="False" Margin="0,0,0,8">
                                            <StackPanel Margin="0,8">
                                                <Label Content="Azure subscription ID" Target="{Binding ElementName=NmeSubscriptionIdBox}" Padding="0" />
                                                <TextBox x:Name="NmeSubscriptionIdBox" AutomationProperties.Name="Nerdio Azure subscription ID" Margin="0,4,0,8" />
                                                <WrapPanel Margin="0,0,0,8">
                                                    <CheckBox x:Name="UseNerdioDeviceCodeToggle" Content="Device authentication" VerticalAlignment="Center" />
                                                    <Button x:Name="ConnectNerdioAzureButton" Content="Connect Azure" Margin="12,0,0,0" Padding="12,4" />
                                                    <Button x:Name="DisconnectNerdioButton" Content="Disconnect Azure and Nerdio" Margin="8,0,0,0" Padding="12,4" />
                                                </WrapPanel>
                                                <Label Content="Resource group" Target="{Binding ElementName=NmeResourceGroupCombo}" Padding="0" />
                                                <ComboBox x:Name="NmeResourceGroupCombo" AutomationProperties.Name="Nerdio resource group" Margin="0,4,0,8" />
                                                <Label Content="Storage account" Target="{Binding ElementName=NmeStorageAccountCombo}" Padding="0" />
                                                <ComboBox x:Name="NmeStorageAccountCombo" AutomationProperties.Name="Nerdio storage account" Margin="0,4,0,8" />
                                                <Label Content="Blob container" Target="{Binding ElementName=NmeContainerCombo}" Padding="0" />
                                                <ComboBox x:Name="NmeContainerCombo" AutomationProperties.Name="Nerdio blob container" Margin="0,4,0,8" />
                                            </StackPanel>
                                        </Expander>
                                        <Button x:Name="SaveNerdioSetupButton" Content="Save setup" HorizontalAlignment="Left" Padding="12,4" Margin="0,8,0,8" />
                                    </StackPanel>
                                </ScrollViewer>
                            </DockPanel>
                        </TabItem>
                    </TabControl>
                </Grid>

                <Grid x:Name="SettingsPanel" Visibility="Collapsed">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MaxWidth="760" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel MaxWidth="760" Margin="0,0,0,8">
                                <TextBlock Text="Appearance"
                                           Style="{StaticResource SectionHeadingTextBlockStyle}"
                                           Margin="0,0,0,8" />
                                <Label Content="Color theme" Target="{Binding ElementName=ThemeCombo}" Padding="0" Margin="0,0,0,4" />
                                <ComboBox x:Name="ThemeCombo"
                                          SelectedIndex="0"
                                          HorizontalAlignment="Left"
                                          MinWidth="180"
                                          Margin="0,0,0,24"
                                          ToolTip="Choose the Workbench color theme"
                                          AutomationProperties.Name="Color theme">
                                    <sys:String>System</sys:String>
                                    <sys:String>Light</sys:String>
                                    <sys:String>Dark</sys:String>
                                </ComboBox>
                                <TextBlock Text="Saved folders"
                                           Style="{StaticResource SectionHeadingTextBlockStyle}"
                                           Margin="0,0,0,8" />
                                <TextBlock Text="Use Browse to change a saved folder. Workflow views also have their own path controls."
                                           TextWrapping="Wrap"
                                           Opacity="0.75"
                                           Margin="0,0,0,16" />
                                <Label Content="Download folder" Target="{Binding ElementName=SettingsDownloadPathBox}" Padding="0" Margin="0,0,0,4" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="SettingsDownloadPathBox"
                                             IsReadOnly="True"
                                             Height="32"
                                             VerticalContentAlignment="Center"
                                             AutomationProperties.Name="Saved download folder" />
                                    <Button x:Name="BrowseDownloadFolderButton"
                                            Grid.Column="1"
                                            Content="Browse"
                                            Margin="8,0,0,0"
                                            Padding="12,4"
                                            AutomationProperties.Name="Browse for download folder" />
                                    <Button x:Name="OpenDownloadFolderButton"
                                            Grid.Column="2"
                                            Content="Open folder"
                                            Margin="8,0,0,0"
                                            Padding="12,4"
                                            IsEnabled="False"
                                            AutomationProperties.Name="Open download folder" />
                                </Grid>
                                <TextBlock x:Name="DownloadFolderStatusLabel"
                                           Text="Folder has not been checked."
                                           TextWrapping="Wrap"
                                           Opacity="0.75"
                                           Margin="0,4,0,16" />
                                <Label Content="Library folder" Target="{Binding ElementName=SettingsLibraryPathBox}" Padding="0" Margin="0,0,0,4" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="SettingsLibraryPathBox"
                                             IsReadOnly="True"
                                             Height="32"
                                             VerticalContentAlignment="Center"
                                             AutomationProperties.Name="Saved library folder" />
                                    <Button x:Name="BrowseLibraryFolderButton"
                                            Grid.Column="1"
                                            Content="Browse"
                                            Margin="8,0,0,0"
                                            Padding="12,4"
                                            AutomationProperties.Name="Browse for library folder" />
                                    <Button x:Name="OpenLibraryFolderButton"
                                            Grid.Column="2"
                                            Content="Open folder"
                                            Margin="8,0,0,0"
                                            Padding="12,4"
                                            IsEnabled="False"
                                            AutomationProperties.Name="Open library folder" />
                                </Grid>
                                <TextBlock x:Name="LibraryFolderStatusLabel"
                                           Text="Folder has not been checked."
                                           TextWrapping="Wrap"
                                           Opacity="0.75"
                                           Margin="0,4,0,16" />
                                <Label Content="Packages definitions folder" Target="{Binding ElementName=SettingsPackageDefinitionsPathBox}" Padding="0" Margin="0,0,0,4" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="SettingsPackageDefinitionsPathBox"
                                             IsReadOnly="True" Height="32" VerticalContentAlignment="Center"
                                             AutomationProperties.Name="Saved Packages definitions folder" />
                                    <Button x:Name="BrowsePackageDefinitionsFolderButton" Grid.Column="1"
                                            Content="Browse" Margin="8,0,0,0" Padding="12,4"
                                            AutomationProperties.Name="Browse for Packages definitions folder" />
                                    <Button x:Name="OpenPackageDefinitionsFolderButton" Grid.Column="2"
                                            Content="Open folder" Margin="8,0,0,0" Padding="12,4" IsEnabled="False"
                                            AutomationProperties.Name="Open Packages definitions folder" />
                                </Grid>
                                <TextBlock x:Name="PackageDefinitionsFolderStatusLabel"
                                           Text="Folder has not been checked." TextWrapping="Wrap" Opacity="0.75"
                                           Margin="0,4,0,16" />
                                <Label Content="Microsoft 365 Apps configurations folder" Target="{Binding ElementName=SettingsM365ConfigurationsPathBox}" Padding="0" Margin="0,0,0,4" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="SettingsM365ConfigurationsPathBox"
                                             IsReadOnly="True" Height="32" VerticalContentAlignment="Center"
                                             AutomationProperties.Name="Saved Microsoft 365 Apps configurations folder" />
                                    <Button x:Name="BrowseM365ConfigurationsFolderButton" Grid.Column="1"
                                            Content="Browse" Margin="8,0,0,0" Padding="12,4"
                                            AutomationProperties.Name="Browse for Microsoft 365 Apps configurations folder" />
                                    <Button x:Name="OpenM365ConfigurationsFolderButton" Grid.Column="2"
                                            Content="Open folder" Margin="8,0,0,0" Padding="12,4" IsEnabled="False"
                                            AutomationProperties.Name="Open Microsoft 365 Apps configurations folder" />
                                </Grid>
                                <TextBlock x:Name="M365ConfigurationsFolderStatusLabel"
                                           Text="Folder has not been checked." TextWrapping="Wrap" Opacity="0.75"
                                           Margin="0,4,0,16" />
                                <Label Content="Nerdio Manager Shell Apps directory" Target="{Binding ElementName=SettingsNerdioDefinitionsPathBox}" Padding="0" Margin="0,0,0,4" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="SettingsNerdioDefinitionsPathBox"
                                             IsReadOnly="True" Height="32" VerticalContentAlignment="Center"
                                             AutomationProperties.Name="Saved Nerdio Manager Shell Apps directory" />
                                    <Button x:Name="BrowseNerdioDefinitionsFolderButton" Grid.Column="1"
                                            Content="Browse" Margin="8,0,0,0" Padding="12,4"
                                            AutomationProperties.Name="Browse for Nerdio Manager Shell Apps directory" />
                                    <Button x:Name="OpenNerdioDefinitionsFolderButton" Grid.Column="2"
                                            Content="Open folder" Margin="8,0,0,0" Padding="12,4" IsEnabled="False"
                                            AutomationProperties.Name="Open Nerdio Manager Shell Apps directory" />
                                </Grid>
                                <TextBlock x:Name="NerdioDefinitionsFolderStatusLabel"
                                           Text="Folder has not been checked."
                                           TextWrapping="Wrap"
                                           Opacity="0.75"
                                           Margin="0,4,0,0" />
                                <TextBlock Text="Maintenance"
                                           Style="{StaticResource SectionHeadingTextBlockStyle}"
                                           Margin="0,24,0,8" />
                                <WrapPanel Margin="0,0,0,8">
                                    <Button x:Name="SettingsUpdateEvergreenButton"
                                            Content="Update Evergreen"
                                            Padding="12,4"
                                            Margin="0,0,8,8"
                                            AutomationProperties.Name="Update Evergreen application data" />
                                    <Button x:Name="SettingsClearCacheButton"
                                            Content="Clear Workbench cache"
                                            Padding="12,4"
                                            Margin="0,0,8,8"
                                            AutomationProperties.Name="Clear Workbench cache" />
                                    <Button x:Name="SettingsOpenCacheFolderButton"
                                            Content="Open cache folder"
                                            Padding="12,4"
                                            Margin="0,0,8,8"
                                            AutomationProperties.Name="Open Workbench cache folder" />
                                </WrapPanel>
                                <TextBlock x:Name="SettingsMaintenanceStatusLabel"
                                           Text="Maintenance ready"
                                           TextWrapping="Wrap"
                                           Opacity="0.75"
                                           Margin="0,0,0,24" />
                                <TextBlock Text="Window layout"
                                           Style="{StaticResource SectionHeadingTextBlockStyle}"
                                           Margin="0,0,0,8" />
                                <TextBlock Text="Reset the saved Workbench size and panel layout to their defaults."
                                           TextWrapping="Wrap"
                                           Opacity="0.75"
                                           Margin="0,0,0,8" />
                                <Button x:Name="SettingsResetLayoutButton"
                                        Content="Reset window layout"
                                        HorizontalAlignment="Left"
                                        Padding="12,4"
                                        Margin="0,0,0,8"
                                        AutomationProperties.Name="Reset window layout" />
                                <TextBlock x:Name="SettingsLayoutStatusLabel"
                                           TextWrapping="Wrap"
                                           Opacity="0.75"
                                           Margin="0,0,0,24" />
                                <TextBlock Text="Restore defaults"
                                           Style="{StaticResource SectionHeadingTextBlockStyle}"
                                           Margin="0,0,0,8" />
                                <TextBlock Text="Restore settings and UI preferences. Downloads, Library contents and provider recovery records are not folders managed by this reset."
                                           TextWrapping="Wrap"
                                           Opacity="0.75"
                                           Margin="0,0,0,8" />
                                <Button x:Name="SettingsRestoreDefaultsButton"
                                        Content="Restore Workbench defaults"
                                        HorizontalAlignment="Left"
                                        Padding="12,4"
                                        Margin="0,0,0,8"
                                        AutomationProperties.Name="Restore Workbench defaults" />
                                <TextBlock x:Name="SettingsRestoreStatusLabel"
                                           TextWrapping="Wrap"
                                           Opacity="0.75"
                                           Margin="0,0,0,0" />
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </Grid>

                <Grid x:Name="AboutPanel" Visibility="Collapsed">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MaxWidth="900" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel MaxWidth="900" Margin="0,0,0,8">
                                <TextBlock x:Name="AboutNameValue"
                                           Style="{StaticResource SectionHeadingTextBlockStyle}"
                                           Margin="0,0,0,8" />
                                <TextBlock x:Name="AboutVersionValue" Margin="0,0,0,4" />
                                <TextBlock x:Name="AboutAuthorValue" Margin="0,0,0,4" />
                                <TextBlock x:Name="AboutCompanyValue" Margin="0,0,0,4" />
                                <TextBlock x:Name="AboutCopyrightValue"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,8" />
                                <TextBlock x:Name="AboutDescriptionValue"
                                           TextWrapping="Wrap"
                                           Opacity="0.75"
                                           Margin="0,0,0,8" />
                                <TextBlock Margin="0,0,0,16">
                                    <Hyperlink x:Name="AboutProjectLink">Project website</Hyperlink>
                                    <Run Text="    " />
                                    <Hyperlink x:Name="AboutLicenseLink">License</Hyperlink>
                                </TextBlock>
                                <TextBlock x:Name="AboutLinkStatusLabel"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,8" />
                                <TextBlock Text="Dependencies"
                                           Style="{StaticResource SectionHeadingTextBlockStyle}"
                                           Margin="0,0,0,8" />
                                <TextBlock Text="Installed is the highest discoverable version. Loaded versions are for the Workbench window runspace; background Jobs and the caller can differ."
                                           TextWrapping="Wrap"
                                           Opacity="0.75"
                                           Margin="0,0,0,8" />
                                <DockPanel Margin="0,0,0,8">
                                    <Button x:Name="RefreshAboutDependenciesButton"
                                            DockPanel.Dock="Right"
                                            Content="Refresh"
                                            Padding="12,4"
                                            AutomationProperties.Name="Refresh dependency status" />
                                    <TextBlock x:Name="AboutDependencyStatusLabel"
                                               Text="Dependency status has not been checked."
                                               TextWrapping="Wrap"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0" />
                                </DockPanel>
                                <DataGrid x:Name="AboutDependenciesListView"
                                          Height="260"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          SelectionMode="Single"
                                          HeadersVisibility="Column"
                                          CanUserAddRows="False"
                                          EnableRowVirtualization="True"
                                          AutomationProperties.Name="Workbench dependency status">
                                    <DataGrid.Resources>
                                        <Style x:Key="DependencyCellStyle" TargetType="{x:Type TextBlock}"
                                               BasedOn="{StaticResource WorkbenchGridTextStyle}">
                                            <Setter Property="TextWrapping" Value="Wrap" />
                                        </Style>
                                    </DataGrid.Resources>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Module" Binding="{Binding Name}"
                                                            Width="150" ElementStyle="{StaticResource DependencyCellStyle}" />
                                        <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="80" ElementStyle="{StaticResource WorkbenchGridTextStyle}" />
                                        <DataGridTextColumn Header="Installed" Binding="{Binding InstalledVersion}" Width="110" ElementStyle="{StaticResource WorkbenchGridTextStyle}" />
                                        <DataGridTextColumn Header="Loaded (window)" Binding="{Binding LoadedVersions}"
                                                            Width="150" ElementStyle="{StaticResource DependencyCellStyle}" />
                                        <DataGridTextColumn Header="Minimum" Binding="{Binding MinimumVersion}" Width="100" ElementStyle="{StaticResource WorkbenchGridTextStyle}" />
                                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="120" ElementStyle="{StaticResource WorkbenchGridTextStyle}" />
                                        <DataGridTextColumn Header="Purpose" Binding="{Binding Purpose}"
                                                            Width="220" ElementStyle="{StaticResource DependencyCellStyle}" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Grid>

            <DockPanel Grid.Row="2" Margin="0,12,0,0">
                <TextBlock x:Name="AppsMaintenanceStatusLabel"
                           DockPanel.Dock="Top"
                           Text="Maintenance ready"
                           TextWrapping="Wrap"
                           Visibility="{Binding Visibility, ElementName=AppsPanel}"
                           Margin="0,0,0,8" />
                <ProgressBar x:Name="JobProgressBar"
                             Height="6"
                             Minimum="0"
                             Maximum="100"
                             Value="0"
                             Visibility="Collapsed" />
            </DockPanel>
        </Grid>

        <Expander Grid.Column="1"
                  Grid.Row="1"
                  Header="Activity log"
                  IsExpanded="False"
                  Margin="24,0,24,12">
            <StackPanel>
                <Thumb x:Name="ActivityLogResizeThumb"
                       Height="8"
                       Cursor="SizeNS"
                       Focusable="True"
                       ToolTip="Drag or use the up and down arrow keys to resize the activity log"
                       AutomationProperties.Name="Resize activity log" />
                <TextBox x:Name="ActivityLog"
                     Height="140"
                     IsReadOnly="True"
                     AcceptsReturn="True"
                     TextWrapping="NoWrap"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"
                     FontFamily="Consolas"
                     FontSize="12"
                     AutomationProperties.Name="Workbench activity log" />
            </StackPanel>
        </Expander>
    </Grid>
</Window>
