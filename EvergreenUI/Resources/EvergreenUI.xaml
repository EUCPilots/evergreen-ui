<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Workbench (beta)"
        MinWidth="900" MinHeight="600"
        Width="1200" Height="750"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}"
        FontFamily="Segoe UI"
        FontSize="13">

    <Window.Resources>

        <!-- ── Brushes - placeholder transparent; theme functions fill them on Loaded ── -->
        <SolidColorBrush x:Key="WindowBackgroundBrush"  Color="Transparent"/>
        <SolidColorBrush x:Key="TextPrimaryBrush"       Color="Transparent"/>
        <SolidColorBrush x:Key="TextSecondaryBrush"     Color="Transparent"/>
        <SolidColorBrush x:Key="AccentBrush"            Color="Transparent"/>
        <SolidColorBrush x:Key="AccentHoverBrush"       Color="Transparent"/>
        <SolidColorBrush x:Key="AccentLightBrush"       Color="Transparent"/>
        <SolidColorBrush x:Key="ControlBackgroundBrush" Color="Transparent"/>
        <SolidColorBrush x:Key="ControlBorderBrush"     Color="Transparent"/>
        <SolidColorBrush x:Key="ButtonForegroundBrush"  Color="Transparent"/>
        <SolidColorBrush x:Key="ToggleThumbBrush"       Color="Transparent"/>
        <SolidColorBrush x:Key="SecondaryButtonBackgroundBrush" Color="Transparent"/>
        <SolidColorBrush x:Key="SecondaryButtonBorderBrush"     Color="Transparent"/>
        <SolidColorBrush x:Key="StatusPositiveBrush"      Color="Transparent"/>
        <SolidColorBrush x:Key="StatusErrorBrush"         Color="Transparent"/>
        <SolidColorBrush x:Key="StatusWarningBrush"       Color="Transparent"/>
        <SolidColorBrush x:Key="StatusPositiveLightBrush" Color="Transparent"/>
        <SolidColorBrush x:Key="StatusWarningLightBrush"  Color="Transparent"/>
        <SolidColorBrush x:Key="StatusErrorLightBrush"    Color="Transparent"/>

        <!-- ── FluentButton ── -->
        <Style x:Key="FluentButton" TargetType="Button">
            <Setter Property="Background"      Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground"      Value="{DynamicResource ButtonForegroundBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="16,6"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.82"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.65"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── FluentSecondaryButton ── -->
        <Style x:Key="FluentSecondaryButton" TargetType="Button" BasedOn="{StaticResource FluentButton}">
            <Setter Property="Background"      Value="{DynamicResource SecondaryButtonBackgroundBrush}"/>
            <Setter Property="Foreground"      Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource SecondaryButtonBorderBrush}"/>
        </Style>

        <!-- ── FluentTextBox ── -->
        <Style x:Key="FluentTextBox" TargetType="TextBox">
            <Setter Property="Background"               Value="{DynamicResource ControlBackgroundBrush}"/>
            <Setter Property="Foreground"               Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush"              Value="{DynamicResource ControlBorderBrush}"/>
            <Setter Property="BorderThickness"          Value="1"/>
            <Setter Property="Padding"                  Value="8,0"/>
            <Setter Property="MinHeight"                Value="32"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="CaretBrush"               Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="SelectionBrush"           Value="{DynamicResource AccentLightBrush}"/>
            <Setter Property="FocusVisualStyle"         Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Focusable="False"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="bd" Property="BorderThickness" Value="1.5"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── FluentListView ── -->
        <Style x:Key="FluentListView" TargetType="ListView">
            <Setter Property="Background"      Value="{DynamicResource ControlBackgroundBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground"      Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="MinHeight"                  Value="32"/>
                        <Setter Property="Padding"                    Value="0"/>
                        <Setter Property="Foreground"                 Value="{DynamicResource TextPrimaryBrush}"/>
                        <Setter Property="FocusVisualStyle"           Value="{x:Null}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListViewItem">
                                    <Border x:Name="bd"
                                            Background="Transparent"
                                            Padding="{TemplateBinding Padding}">
                                        <GridViewRowPresenter Content="{TemplateBinding Content}"
                                                              HorizontalAlignment="Stretch"
                                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background"
                                                    Value="{DynamicResource AccentLightBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="bd" Property="Background"
                                                    Value="{DynamicResource AccentLightBrush}"/>
                                            <Setter Property="Foreground"
                                                    Value="{DynamicResource AccentBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Fluent context menu styling for runtime-generated menus -->
        <Style x:Key="FluentContextMenu" TargetType="ContextMenu">
            <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Padding" Value="4"/>
        </Style>

        <Style x:Key="FluentMenuItem" TargetType="MenuItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="2,1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="18"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Path x:Name="CheckGlyph"
                                      Grid.Column="0"
                                      Margin="0,0,8,0"
                                      VerticalAlignment="Center"
                                      Data="M 1.5 7 L 5 10.5 L 12 3"
                                      Stroke="{DynamicResource AccentBrush}"
                                      StrokeThickness="1.5"
                                      StrokeLineJoin="Round"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Visibility="Collapsed"/>
                                <ContentPresenter Grid.Column="1"
                                                  ContentSource="Header"
                                                  VerticalAlignment="Center"
                                                  RecognizesAccessKey="True"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource AccentLightBrush}"/>
                            </Trigger>
                            <Trigger Property="IsCheckable" Value="True">
                                <Setter TargetName="CheckGlyph" Property="Visibility" Value="Hidden"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsCheckable" Value="True"/>
                                    <Condition Property="IsChecked" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="CheckGlyph" Property="Visibility" Value="Visible"/>
                            </MultiTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── FluentCheckBox ── -->
        <Style x:Key="FluentCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground"               Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Cursor"                   Value="Hand"/>
            <Setter Property="Height"                   Value="32"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="box"
                                    Width="14" Height="14"
                                    CornerRadius="2"
                                    BorderThickness="1.5"
                                    BorderBrush="{DynamicResource ControlBorderBrush}"
                                    Background="{DynamicResource ControlBackgroundBrush}"
                                    VerticalAlignment="Center"
                                    Margin="0,0,6,0">
                                <Path x:Name="check"
                                      Data="M 1.5 7 L 5 10.5 L 12 3"
                                      Stroke="{DynamicResource AccentBrush}"
                                      StrokeThickness="1.5"
                                      StrokeLineJoin="Round"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Visibility="Collapsed"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                            </Border>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="check" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="box"   Property="BorderBrush"
                                        Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="box"   Property="Background"
                                        Value="{DynamicResource AccentLightBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="box" Property="BorderBrush"
                                        Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── FluentToggleSwitch ── -->
        <Style x:Key="FluentToggleSwitch" TargetType="ToggleButton">
            <Setter Property="Cursor"   Value="Hand"/>
            <Setter Property="Width"    Value="36"/>
            <Setter Property="Height"   Value="20"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid Width="36" Height="20">
                            <Border x:Name="track"
                                    CornerRadius="10"
                                    Background="{DynamicResource ControlBorderBrush}"/>
                            <Ellipse x:Name="thumb"
                                     Width="14" Height="14"
                                     Fill="{DynamicResource ToggleThumbBrush}"
                                     HorizontalAlignment="Left"
                                     Margin="3,0,0,0"
                                     VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="track" Property="Background"
                                        Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="thumb" Property="HorizontalAlignment"
                                        Value="Right"/>
                                <Setter TargetName="thumb" Property="Margin"
                                        Value="0,0,3,0"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="track" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── FluentComboBox ── -->
        <Style x:Key="FluentComboBox" TargetType="ComboBox">
            <Setter Property="Background"               Value="{DynamicResource ControlBackgroundBrush}"/>
            <Setter Property="Foreground"               Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush"              Value="{DynamicResource ControlBorderBrush}"/>
            <Setter Property="BorderThickness"          Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding"                  Value="8,0"/>
            <Setter Property="Cursor"                   Value="Hand"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}"/>
                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                        <Setter Property="Padding"    Value="8,6"/>
                        <Setter Property="Cursor"     Value="Hand"/>
                        <Style.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter Property="Background" Value="{DynamicResource AccentLightBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{DynamicResource AccentLightBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="bd"
                                    Background="{DynamicResource ControlBackgroundBrush}"
                                    BorderBrush="{DynamicResource ControlBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="28"/>
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter Grid.Column="0"
                                                      IsHitTestVisible="False"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      Margin="10,0,4,0"
                                                      VerticalAlignment="Center"/>
                                    <Path Grid.Column="1"
                                          Data="M 0 0 L 4 4 L 8 0"
                                          Stroke="{DynamicResource TextSecondaryBrush}"
                                          StrokeThickness="1.5"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          IsHitTestVisible="False"/>
                                    <ToggleButton Grid.Column="0"
                                                  Grid.ColumnSpan="2"
                                                  Focusable="False"
                                                  Background="Transparent"
                                                  BorderThickness="0"
                                                  IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                                              RelativeSource={RelativeSource TemplatedParent}}"
                                                  ClickMode="Press">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                </Grid>
                            </Border>
                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Border Background="{DynamicResource ControlBackgroundBrush}"
                                        BorderBrush="{DynamicResource ControlBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="0,0,4,4"
                                        MinWidth="{Binding ActualWidth,
                                                   RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <ScrollViewer SnapsToDevicePixels="True">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush"
                                        Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── NavRailRadioButton - Fluent NavigationView item pattern ── -->
        <Style x:Key="NavRailRadioButton" TargetType="RadioButton">
            <Setter Property="GroupName"                 Value="Navigation"/>
            <Setter Property="HorizontalAlignment"       Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding"                   Value="14,10"/>
            <Setter Property="Background"                Value="Transparent"/>
            <Setter Property="Foreground"                Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderThickness"           Value="0"/>
            <Setter Property="Cursor"                    Value="Hand"/>
            <Setter Property="FontSize"                  Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Margin="4,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="accent"
                                        Grid.Column="0"
                                        CornerRadius="2"
                                        Margin="0,8"
                                        Background="Transparent"/>
                                <ContentPresenter Grid.Column="1"
                                                  Margin="{TemplateBinding Padding}"
                                                  VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd"     Property="Background"
                                        Value="{DynamicResource AccentLightBrush}"/>
                                <Setter TargetName="accent" Property="Background"
                                        Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Foreground"
                                        Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background"
                                        Value="{DynamicResource AccentLightBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── StatusDot - 8x8 coloured indicator ── -->
        <Style x:Key="StatusDot" TargetType="Ellipse">
            <Setter Property="Width"             Value="8"/>
            <Setter Property="Height"            Value="8"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin"            Value="0,0,5,0"/>
        </Style>

        <!-- ── FluentTabControl / FluentTabItem - underline pivot style ── -->
        <Style x:Key="FluentTabControl" TargetType="TabControl">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0"
                                    BorderBrush="{DynamicResource ControlBorderBrush}"
                                    BorderThickness="0,0,0,1">
                                <TabPanel x:Name="HeaderPanel"
                                          IsItemsHost="True"
                                          Background="Transparent"
                                          KeyboardNavigation.TabIndex="1"/>
                            </Border>
                            <ContentPresenter Grid.Row="1"
                                              x:Name="PART_SelectedContentHost"
                                              Margin="0,14,0,0"
                                              HorizontalAlignment="Stretch"
                                              VerticalAlignment="Stretch"
                                              ContentSource="SelectedContent"
                                              KeyboardNavigation.TabIndex="2"
                                              KeyboardNavigation.DirectionalNavigation="Contained"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FluentTabItem" TargetType="TabItem">
            <Setter Property="Background"               Value="Transparent"/>
            <Setter Property="Foreground"               Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="BorderThickness"          Value="0"/>
            <Setter Property="Cursor"                   Value="Hand"/>
            <Setter Property="FontSize"                 Value="13"/>
            <Setter Property="MinWidth"                 Value="160"/>
            <Setter Property="MinHeight"                Value="44"/>
            <Setter Property="Margin"                   Value="0,0,4,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="bd" Background="Transparent" Padding="16,10,16,10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="2"/>
                                </Grid.RowDefinitions>
                                <ContentPresenter Grid.Row="0"
                                                  x:Name="HeaderContentPresenter"
                                                  ContentSource="Header"
                                                  Margin="0"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  SnapsToDevicePixels="True"/>
                                <Border x:Name="underline"
                                        Grid.Row="1"
                                        Background="Transparent"
                                        CornerRadius="1"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground"
                                        Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="HeaderContentPresenter"
                                        Property="TextElement.FontWeight"
                                        Value="SemiBold"/>
                                <Setter TargetName="underline" Property="Background"
                                        Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background"
                                        Value="{DynamicResource AccentLightBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ScrollBar helper: transparent repeat button -->
        <Style x:Key="ScrollBarFlatRepeatButton" TargetType="RepeatButton">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Focusable"             Value="False"/>
            <Setter Property="IsTabStop"             Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Rectangle Fill="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ScrollBar helper: themed thumb -->
        <Style x:Key="ScrollBarThumbStyle" TargetType="Thumb">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="IsTabStop"             Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="r"
                                CornerRadius="3"
                                Background="{DynamicResource ControlBorderBrush}"
                                Opacity="0.9"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="r" Property="Background"
                                        Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="r" Property="Opacity" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="r" Property="Background"
                                        Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="r" Property="Opacity" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ScrollBar vertical and horizontal templates -->
        <ControlTemplate x:Key="VerticalScrollBarTemplate" TargetType="ScrollBar">
            <Border Background="{DynamicResource WindowBackgroundBrush}">
                <Track x:Name="PART_Track" IsDirectionReversed="True">
                    <Track.DecreaseRepeatButton>
                        <RepeatButton Style="{StaticResource ScrollBarFlatRepeatButton}"
                                      Command="ScrollBar.PageUpCommand"/>
                    </Track.DecreaseRepeatButton>
                    <Track.Thumb>
                        <Thumb Style="{StaticResource ScrollBarThumbStyle}" Margin="2,0"/>
                    </Track.Thumb>
                    <Track.IncreaseRepeatButton>
                        <RepeatButton Style="{StaticResource ScrollBarFlatRepeatButton}"
                                      Command="ScrollBar.PageDownCommand"/>
                    </Track.IncreaseRepeatButton>
                </Track>
            </Border>
        </ControlTemplate>

        <ControlTemplate x:Key="HorizontalScrollBarTemplate" TargetType="ScrollBar">
            <Border Background="{DynamicResource WindowBackgroundBrush}">
                <Track x:Name="PART_Track" IsDirectionReversed="False">
                    <Track.DecreaseRepeatButton>
                        <RepeatButton Style="{StaticResource ScrollBarFlatRepeatButton}"
                                      Command="ScrollBar.PageLeftCommand"/>
                    </Track.DecreaseRepeatButton>
                    <Track.Thumb>
                        <Thumb Style="{StaticResource ScrollBarThumbStyle}" Margin="0,2"/>
                    </Track.Thumb>
                    <Track.IncreaseRepeatButton>
                        <RepeatButton Style="{StaticResource ScrollBarFlatRepeatButton}"
                                      Command="ScrollBar.PageRightCommand"/>
                    </Track.IncreaseRepeatButton>
                </Track>
            </Border>
        </ControlTemplate>

        <!-- ScrollBar implicit style - applies to all scrollbars in the window -->
        <Style TargetType="ScrollBar">
            <Setter Property="OverridesDefaultStyle"    Value="True"/>
            <Setter Property="Stylus.IsFlicksEnabled"  Value="False"/>
            <Setter Property="Width"                   Value="10"/>
            <Setter Property="MinWidth"                Value="10"/>
            <Setter Property="Template"                Value="{StaticResource VerticalScrollBarTemplate}"/>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width"    Value="Auto"/>
                    <Setter Property="MinWidth" Value="0"/>
                    <Setter Property="Height"   Value="10"/>
                    <Setter Property="MinHeight" Value="10"/>
                    <Setter Property="Template" Value="{StaticResource HorizontalScrollBarTemplate}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ── FluentPasswordBox ── -->
        <Style x:Key="FluentPasswordBox" TargetType="PasswordBox">
            <Setter Property="Background"               Value="{DynamicResource ControlBackgroundBrush}"/>
            <Setter Property="Foreground"               Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush"              Value="{DynamicResource ControlBorderBrush}"/>
            <Setter Property="BorderThickness"          Value="1"/>
            <Setter Property="Padding"                  Value="8,0"/>
            <Setter Property="MinHeight"                Value="32"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="CaretBrush"               Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="SelectionBrush"           Value="{DynamicResource AccentLightBrush}"/>
            <Setter Property="FocusVisualStyle"         Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Focusable="False"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush"
                                        Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush"
                                        Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="bd" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── FluentNavButton - ghost nav button (hamburger / icon-only nav rail button) ── -->
        <Style x:Key="FluentNavButton" TargetType="Button">
            <Setter Property="Background"          Value="Transparent"/>
            <Setter Property="BorderThickness"     Value="0"/>
            <Setter Property="Cursor"              Value="Hand"/>
            <Setter Property="FocusVisualStyle"    Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Margin="0,1">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background"
                                        Value="{DynamicResource AccentLightBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background"
                                        Value="{DynamicResource AccentLightBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── FluentToggleButton - bordered toggle button with checked/unchecked states ── -->
        <Style x:Key="FluentToggleButton" TargetType="ToggleButton">
            <Setter Property="Background"      Value="{DynamicResource ControlBackgroundBrush}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource ControlBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground"      Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}"
                                TextElement.Foreground="{TemplateBinding Foreground}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background"
                                        Value="{DynamicResource AccentLightBrush}"/>
                                <Setter TargetName="bd" Property="BorderBrush"
                                        Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── GridViewColumnHeader - shared Fluent style (hover uses AccentLightBrush) ── -->
        <Style TargetType="GridViewColumnHeader">
            <Setter Property="Background"                 Value="{DynamicResource ControlBackgroundBrush}"/>
            <Setter Property="Foreground"                 Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="FontSize"                   Value="11"/>
            <Setter Property="FontWeight"                 Value="SemiBold"/>
            <Setter Property="Padding"                    Value="12,6"/>
            <Setter Property="BorderBrush"                Value="{DynamicResource ControlBorderBrush}"/>
            <Setter Property="BorderThickness"            Value="0,0,1,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridViewColumnHeader">
                        <Grid>
                            <Border x:Name="bd"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter x:Name="HeaderContent"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="Center"
                                                  RecognizesAccessKey="True"/>
                            </Border>
                            <Thumb x:Name="PART_HeaderGripper"
                                   HorizontalAlignment="Right"
                                   Width="2"
                                   Cursor="SizeWE"
                                   Background="Transparent"
                                   BorderThickness="0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background"
                                        Value="{DynamicResource AccentLightBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background"
                                        Value="{DynamicResource AccentLightBrush}"/>
                            </Trigger>
                            <Trigger Property="Role" Value="Padding">
                                <Setter TargetName="bd"            Property="BorderThickness" Value="0"/>
                                <Setter TargetName="HeaderContent" Property="Visibility"      Value="Collapsed"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <!-- ══════════════════════════════════ Root grid ════════════════════════════════════ -->
    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>                        <!-- 0  Title bar    -->
            <RowDefinition Height="*" MinHeight="200"/>         <!-- 1  Main area     -->
            <RowDefinition Height="8"/>                         <!-- 2  GridSplitter  -->
            <RowDefinition Height="175" MinHeight="40"/>        <!-- 3  Status + Log  -->
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="180"/>     <!-- Nav rail -->
            <ColumnDefinition Width="*"/>       <!-- Content  -->
        </Grid.ColumnDefinitions>

        <!-- ══ ROW 0: Title bar ══════════════════════════════════════════════════════ -->
        <Border Grid.Row="0" Grid.ColumnSpan="2"
                Background="{DynamicResource AccentBrush}">
            <DockPanel LastChildFill="False" Margin="16,0">
                <TextBlock Text="Evergreen Workbench"
                           Foreground="{DynamicResource ButtonForegroundBrush}"
                           FontSize="16" FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           DockPanel.Dock="Left"/>
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            DockPanel.Dock="Right">
                    <Ellipse x:Name="EvergreenStatusDot"
                             AutomationProperties.Name="Evergreen connection status"
                             Style="{StaticResource StatusDot}"
                             Fill="{DynamicResource ControlBorderBrush}"/>
                    <TextBlock x:Name="EvergreenVersionText"
                               Text="Evergreen: checking..."
                               Foreground="{DynamicResource ButtonForegroundBrush}"
                               FontSize="12"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ══ ROW 1, COL 0: Navigation rail ════════════════════════════════════════ -->
        <Border Grid.Row="1" Grid.Column="0"
                BorderBrush="{DynamicResource ControlBorderBrush}"
                BorderThickness="0,0,1,0"
                Background="{DynamicResource WindowBackgroundBrush}">
            <StackPanel Margin="4,12,4,0">
                <!-- Hamburger toggle to collapse/expand the nav rail -->
                <Button x:Name="NavToggleButton"
                        AutomationProperties.Name="Toggle navigation"
                        ToolTip="Collapse/expand navigation"
                        Style="{StaticResource FluentNavButton}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Padding="17,10,14,10"
                        Margin="4,0,4,4">
                    <TextBlock FontFamily="Segoe MDL2 Assets"
                               Text="&#xE700;"
                               FontSize="16"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                </Button>
                <RadioButton x:Name="NavApps"
                             AutomationProperties.Name="Apps"
                             IsChecked="True"
                             Style="{StaticResource NavRailRadioButton}">
                    <RadioButton.Content>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE71D;" FontSize="16" VerticalAlignment="Center"/>
                            <TextBlock x:Name="NavAppsLabel" Text="Apps" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </StackPanel>
                    </RadioButton.Content>
                </RadioButton>
                <RadioButton x:Name="NavDownload"
                             AutomationProperties.Name="Download"
                             Style="{StaticResource NavRailRadioButton}">
                    <RadioButton.Content>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE896;" FontSize="16" VerticalAlignment="Center"/>
                            <TextBlock x:Name="NavDownloadLabel" Text="Download" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </StackPanel>
                    </RadioButton.Content>
                </RadioButton>
                <RadioButton x:Name="NavLibrary"
                             AutomationProperties.Name="Library"
                             Style="{StaticResource NavRailRadioButton}">
                    <RadioButton.Content>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8F1;" FontSize="16" VerticalAlignment="Center"/>
                            <TextBlock x:Name="NavLibraryLabel" Text="Library" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </StackPanel>
                    </RadioButton.Content>
                </RadioButton>
                <RadioButton x:Name="NavImport"
                             AutomationProperties.Name="Import"
                             Style="{StaticResource NavRailRadioButton}">
                    <RadioButton.Content>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8B5;" FontSize="16" VerticalAlignment="Center"/>
                            <TextBlock x:Name="NavImportLabel" Text="Import" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </StackPanel>
                    </RadioButton.Content>
                </RadioButton>
                <RadioButton x:Name="NavInstall"
                             AutomationProperties.Name="Install"
                             Style="{StaticResource NavRailRadioButton}">
                    <RadioButton.Content>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE7B8;" FontSize="16" VerticalAlignment="Center"/>
                            <TextBlock x:Name="NavInstallLabel" Text="Install" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </StackPanel>
                    </RadioButton.Content>
                </RadioButton>
                <Rectangle Height="1"
                           Fill="{DynamicResource ControlBorderBrush}"
                           Margin="14,8"/>
                <RadioButton x:Name="NavSettings"
                             AutomationProperties.Name="Settings"
                             Style="{StaticResource NavRailRadioButton}">
                    <RadioButton.Content>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE713;" FontSize="16" VerticalAlignment="Center"/>
                            <TextBlock x:Name="NavSettingsLabel" Text="Settings" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </StackPanel>
                    </RadioButton.Content>
                </RadioButton>
                <RadioButton x:Name="NavUpdate"
                             AutomationProperties.Name="Update"
                             Style="{StaticResource NavRailRadioButton}">
                    <RadioButton.Content>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE895;" FontSize="16" VerticalAlignment="Center"/>
                            <TextBlock x:Name="NavUpdateLabel" Text="Update" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </StackPanel>
                    </RadioButton.Content>
                </RadioButton>
                <RadioButton x:Name="NavAbout"
                             AutomationProperties.Name="About"
                             Style="{StaticResource NavRailRadioButton}">
                    <RadioButton.Content>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE946;" FontSize="16" VerticalAlignment="Center"/>
                            <TextBlock x:Name="NavAboutLabel" Text="About" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </StackPanel>
                    </RadioButton.Content>
                </RadioButton>
            </StackPanel>
        </Border>

        <!-- ══ ROW 1, COL 1: Content panels (visibility-swapped) ════════════════════ -->
        <Grid Grid.Row="1" Grid.Column="1">

            <!-- Apps view -->
            <Grid x:Name="AppsPanel"
                  Visibility="Visible"
                  Background="{DynamicResource WindowBackgroundBrush}">
                <DockPanel>

                    <!-- Header -->
                    <DockPanel DockPanel.Dock="Top" LastChildFill="False" Margin="22,18,22,12">
                        <TextBlock Text="Apps"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   DockPanel.Dock="Left"
                                   VerticalAlignment="Center"/>
                    </DockPanel>

                    <!-- Horizontal divider under header -->
                    <Rectangle DockPanel.Dock="Top"
                               Height="1"
                               Fill="{DynamicResource ControlBorderBrush}"
                               HorizontalAlignment="Stretch"/>

                    <!-- App list (left) + detail (right) - search inside left column -->
                    <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300" MinWidth="180"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Search + APPLICATIONS list -->
                    <Border Grid.Column="0"
                            BorderBrush="{DynamicResource ControlBorderBrush}"
                            BorderThickness="0,0,1,0"
                            Background="{DynamicResource WindowBackgroundBrush}">
                        <DockPanel>
                            <!-- Search bar matching list width -->
                            <Border DockPanel.Dock="Top"
                                    BorderBrush="{DynamicResource ControlBorderBrush}"
                                    BorderThickness="0,0,0,1"
                                    Padding="8,8"
                                    Background="{DynamicResource WindowBackgroundBrush}">
                                <Grid>
                                        <TextBox x:Name="AppSearchBox"
                                                 Style="{StaticResource FluentTextBox}"/>
                                        <TextBlock Text="Search..."
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   IsHitTestVisible="False"
                                                   Margin="10,0,0,0"
                                                   VerticalAlignment="Center"
                                                   FontSize="13">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Text, ElementName=AppSearchBox}" Value="">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                </Grid>
                            </Border>
                            <!-- APPLICATIONS header -->
                            <Border DockPanel.Dock="Top"
                                    BorderBrush="{DynamicResource ControlBorderBrush}"
                                    BorderThickness="0,0,0,1"
                                    Padding="12,8"
                                    Background="{DynamicResource ControlBackgroundBrush}">
                                <DockPanel LastChildFill="False">
                                    <TextBlock Text="APPLICATIONS"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               VerticalAlignment="Center"
                                               DockPanel.Dock="Left"/>
                                    <TextBlock x:Name="AppCountLabel"
                                               Text=""
                                               FontSize="11"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               VerticalAlignment="Center"
                                               DockPanel.Dock="Right"/>
                                </DockPanel>
                            </Border>
                            <!-- Refresh apps list button pinned to bottom of sidebar -->
                            <Border DockPanel.Dock="Bottom"
                                    BorderBrush="{DynamicResource ControlBorderBrush}"
                                    BorderThickness="0,1,0,0"
                                    Padding="8,8"
                                    Background="{DynamicResource WindowBackgroundBrush}">
                                <Button x:Name="RefreshAppsButton"
                                        Content="Refresh apps list"
                                        Style="{StaticResource FluentSecondaryButton}"
                                        HorizontalAlignment="Stretch"
                                        Padding="10,6"/>
                            </Border>
                            <Grid>
                            <ListBox x:Name="AppsListBox"
                                     BorderThickness="0"
                                     Background="{DynamicResource WindowBackgroundBrush}"
                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                     SelectedValuePath="Name"
                                     VirtualizingPanel.IsVirtualizing="True"
                                     VirtualizingPanel.VirtualizationMode="Recycling"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding FriendlyName}"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Padding"                   Value="12,7"/>
                                        <Setter Property="Cursor"                    Value="Hand"/>
                                        <Setter Property="FontSize"                  Value="13"/>
                                        <Setter Property="Foreground"                Value="{DynamicResource TextPrimaryBrush}"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="bd"
                                                            Background="Transparent"
                                                            Padding="{TemplateBinding Padding}"
                                                            CornerRadius="4"
                                                            Margin="4,1">
                                                        <ContentPresenter/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="bd" Property="Background"
                                                                    Value="{DynamicResource AccentLightBrush}"/>
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="bd" Property="Background"
                                                                    Value="{DynamicResource AccentLightBrush}"/>
                                                            <Setter Property="Foreground"
                                                                    Value="{DynamicResource AccentBrush}"/>
                                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                            </ListBox>
                            <!-- Empty-list hint - visible only when AppsListBox has no items -->
                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Margin="16">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasItems, ElementName=AppsListBox}" Value="False">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="No applications loaded."
                                           HorizontalAlignment="Center"
                                           TextAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap"/>
                                <TextBlock Text="Run 'Update-Evergreen' in PowerShell to download the latest app definitions, then click Refresh apps list."
                                           HorizontalAlignment="Center"
                                           TextAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="11"
                                           TextWrapping="Wrap"
                                           Margin="0,6,0,0"/>
                            </StackPanel>
                            </Grid>
                        </DockPanel>
                    </Border>

                    <!-- Right: Version detail -->
                    <Grid Grid.Column="1" Margin="14,14,14,14">

                        <!-- Empty state -->
                        <Border x:Name="AppDetailEmpty"
                                BorderThickness="1"
                                BorderBrush="{DynamicResource ControlBorderBrush}"
                                Background="{DynamicResource ControlBackgroundBrush}"
                                CornerRadius="4"
                                ClipToBounds="True"
                                Visibility="Visible">
                            <TextBlock Text="Select an application to view version details"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontSize="13"/>
                        </Border>

                        <!-- Loading state -->
                        <Border x:Name="AppDetailLoading"
                                BorderThickness="1"
                                BorderBrush="{DynamicResource ControlBorderBrush}"
                                Background="{DynamicResource ControlBackgroundBrush}"
                                CornerRadius="4"
                                ClipToBounds="True"
                                Visibility="Collapsed">
                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Width="360">
                                <TextBlock x:Name="AppDetailLoadingLabel"
                                           Text="Retrieving application details with Evergreen…"
                                           HorizontalAlignment="Center"
                                           TextAlignment="Center"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,14"/>
                                <ProgressBar IsIndeterminate="True"
                                             Height="3"
                                             Foreground="{DynamicResource AccentBrush}"
                                             Background="{DynamicResource ControlBorderBrush}"
                                             BorderThickness="0"/>
                                <TextBlock Text="Some applications may take a moment to respond"
                                           HorizontalAlignment="Center"
                                           TextAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="11"
                                           Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Detail panel -->
                        <Border x:Name="AppDetailContent"
                                BorderThickness="1"
                                BorderBrush="{DynamicResource ControlBorderBrush}"
                                Background="{DynamicResource ControlBackgroundBrush}"
                                CornerRadius="4"
                                ClipToBounds="True"
                                Visibility="Collapsed">
                            <DockPanel>

                                <!-- Header: Refresh + APPNAME VERSION DETAILS -->
                                <Border DockPanel.Dock="Top"
                                        BorderBrush="{DynamicResource ControlBorderBrush}"
                                        BorderThickness="0,0,0,1"
                                        Padding="14,8"
                                        Background="{DynamicResource ControlBackgroundBrush}">
                                    <DockPanel LastChildFill="True">
                                        <Button x:Name="LoadAppVersionsButton"
                                                Content="Refresh"
                                                DockPanel.Dock="Left"
                                                Style="{StaticResource FluentSecondaryButton}"
                                                Padding="25,6"
                                                Margin="0,0,12,0"/>
                                        <TextBlock x:Name="AppDetailTitle"
                                                   Text=""
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center"/>
                                    </DockPanel>
                                </Border>

                                <!-- Filters strip -->
                                <Border DockPanel.Dock="Top"
                                        BorderBrush="{DynamicResource ControlBorderBrush}"
                                        BorderThickness="0,0,0,1"
                                        Padding="12,10">
                                    <WrapPanel x:Name="FilterWrapPanel"
                                               Orientation="Horizontal"/>
                                </Border>

                                <!-- Results meta + action buttons -->
                                <DockPanel DockPanel.Dock="Top"
                                           LastChildFill="False"
                                           Margin="14,8">
                                    <TextBlock x:Name="ResultsCountLabel"
                                               Text="Showing 0 of 0"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               FontSize="12"
                                               VerticalAlignment="Center"
                                               DockPanel.Dock="Left"/>
                                    <TextBlock x:Name="AppsActionStatusLabel"
                                               Text=""
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               FontSize="12"
                                               VerticalAlignment="Center"
                                               Margin="12,0,0,0"
                                               DockPanel.Dock="Left"/>
                                    <StackPanel Orientation="Horizontal"
                                                DockPanel.Dock="Right">
                                        <Button x:Name="ClearFiltersButton"
                                                Content="Clear filters"
                                                Style="{StaticResource FluentSecondaryButton}"
                                                Padding="10,6"
                                                Margin="0,0,6,0"/>
                                        <Button x:Name="ExportCsvButton"
                                                Content="Export to CSV"
                                                Style="{StaticResource FluentSecondaryButton}"
                                                Padding="10,6"
                                                Margin="0,0,6,0"/>
                                        <Button x:Name="AddToLibraryButton"
                                                Content="Add to Library"
                                                Style="{StaticResource FluentSecondaryButton}"
                                                Padding="10,6"
                                                Margin="0,0,6,0"
                                                IsEnabled="False"/>
                                        <Button x:Name="AddToQueueButton"
                                                Content="Add to download queue"
                                                Style="{StaticResource FluentButton}"
                                                Padding="12,6"/>
                                    </StackPanel>
                                </DockPanel>

                                <!-- Versions table -->
                                <ListView x:Name="VersionsListView"
                                          Style="{StaticResource FluentListView}"
                                          BorderBrush="{DynamicResource ControlBorderBrush}"
                                          BorderThickness="0,1,0,0"
                                          SelectionMode="Extended">
                                    <ListView.View>
                                        <GridView>
                                            <GridViewColumn Header="Version"       DisplayMemberBinding="{Binding Version}"       Width="130"/>
                                            <GridViewColumn Header="Channel"       DisplayMemberBinding="{Binding Channel}"       Width="110"/>
                                            <GridViewColumn Header="Release"       DisplayMemberBinding="{Binding Release}"       Width="100"/>
                                            <GridViewColumn Header="Architecture"  DisplayMemberBinding="{Binding Architecture}"  Width="110"/>
                                            <GridViewColumn Header="Type"          DisplayMemberBinding="{Binding Type}"          Width="70"/>
                                            <GridViewColumn Header="Date"          DisplayMemberBinding="{Binding Date}"          Width="100"/>
                                            <GridViewColumn Header="Uri"           Width="460">
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding URI}" TextTrimming="CharacterEllipsis" ToolTip="{Binding URI}"/>
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>
                                        </GridView>
                                    </ListView.View>
                                </ListView>

                            </DockPanel>
                        </Border>

                    </Grid>
                    </Grid>
                </DockPanel>
            </Grid>

            <!-- Download view - Phase 5 -->
            <Grid x:Name="DownloadPanel"
                  Visibility="Collapsed"
                  Background="{DynamicResource WindowBackgroundBrush}">
                <Grid Margin="22,18,22,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,12">
                        <StackPanel DockPanel.Dock="Left">
                            <TextBlock Text="Download"
                                       FontSize="20"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock x:Name="QueueCountLabel"
                                       Text="Queue: 0 items"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Margin="0,3,0,0"/>
                        </StackPanel>

                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="RemoveQueueItemButton"
                                    Content="Remove selected"
                                    Style="{StaticResource FluentSecondaryButton}"
                                    Padding="10,6"
                                    Margin="0,0,6,0"/>
                            <Button x:Name="ClearQueueButton"
                                    Content="Clear queue"
                                    Style="{StaticResource FluentSecondaryButton}"
                                    Padding="10,6"
                                    Margin="0,0,6,0"/>
                            <Button x:Name="OpenDownloadFolderButton"
                                    Content="Open folder"
                                    Style="{StaticResource FluentSecondaryButton}"
                                    Padding="10,6"
                                    Margin="0,0,6,0"/>
                            <Button x:Name="DownloadAllButton"
                                    Content="Download all"
                                    Style="{StaticResource FluentButton}"
                                    Padding="12,6"/>
                        </StackPanel>
                    </DockPanel>

                    <Border Grid.Row="1"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource ControlBorderBrush}"
                            Background="{DynamicResource ControlBackgroundBrush}"
                            CornerRadius="4">
                        <ListView x:Name="DownloadQueueListView"
                                  Style="{StaticResource FluentListView}"
                                  SelectionMode="Single">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Status"       DisplayMemberBinding="{Binding Status}"        Width="110"/>
                                    <GridViewColumn Header="App"          DisplayMemberBinding="{Binding AppName}"       Width="180"/>
                                    <GridViewColumn Header="Version"      DisplayMemberBinding="{Binding Version}"       Width="130"/>
                                    <GridViewColumn Header="Architecture" DisplayMemberBinding="{Binding Architecture}"  Width="110"/>
                                    <GridViewColumn Header="URI"          Width="390">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Uri}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Uri}"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Path"         Width="280">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Path}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </Border>

                    <StackPanel Grid.Row="2" Margin="0,10,0,0">
                        <ProgressBar x:Name="DownloadProgressBar"
                                     Visibility="Collapsed"
                                     IsIndeterminate="False"
                                     Height="3"
                                     Foreground="{DynamicResource AccentBrush}"
                                     Background="{DynamicResource ControlBorderBrush}"
                                     BorderThickness="0"/>
                        <TextBlock Text="Downloads are processed sequentially and in queue order."
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,8,0,0"/>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- Library view - Phase 6 -->
            <Grid x:Name="LibraryPanel"
                  Visibility="Collapsed"
                  Background="{DynamicResource WindowBackgroundBrush}">
                <Grid Margin="22,18,22,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,12">
                        <TextBlock Text="Library"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   DockPanel.Dock="Left"
                                   VerticalAlignment="Center"/>
                    </DockPanel>

                    <Grid Grid.Row="1" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="Library path"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontSize="12"
                                       Margin="0,0,0,4"/>
                            <TextBox x:Name="LibraryPathViewBox"
                                     Style="{StaticResource FluentTextBox}"/>
                        </StackPanel>

                        <Button Grid.Column="1"
                                x:Name="BrowseLibraryButton"
                                Content="Browse"
                                Style="{StaticResource FluentSecondaryButton}"
                                MinWidth="50"
                                Margin="0,18,6,0"
                                Padding="10,6"/>

                        <Button Grid.Column="2"
                                x:Name="LibraryNewButton"
                                Content="New Library"
                                Style="{StaticResource FluentSecondaryButton}"
                                MinWidth="50"
                                Margin="0,18,6,0"
                                Padding="10,6"/>

                        <Button Grid.Column="3"
                                x:Name="LibraryOpenFolderButton"
                                Content="Open folder"
                                Style="{StaticResource FluentSecondaryButton}"
                                MinWidth="50"
                                Margin="0,18,6,0"
                                Padding="10,6"/>

                        <Button Grid.Column="4"
                                x:Name="LibraryRefreshButton"
                                Content="Refresh Library"
                                Style="{StaticResource FluentSecondaryButton}"
                                MinWidth="50"
                                Margin="0,18,6,0"
                                Padding="10,6"/>

                        <Button Grid.Column="5"
                                x:Name="LibraryUpdateButton"
                                Content="Update Library"
                                Style="{StaticResource FluentButton}"
                                MinWidth="50"
                                Margin="0,18,0,0"
                                Padding="10,6"/>
                    </Grid>

                    <ProgressBar x:Name="LibraryUpdateProgressBar"
                                 Grid.Row="2"
                                 Visibility="Collapsed"
                                 IsIndeterminate="True"
                                 Height="3"
                                 Margin="0,0,0,8"
                                 Foreground="{DynamicResource AccentBrush}"
                                 Background="{DynamicResource ControlBorderBrush}"
                                 BorderThickness="0"/>

                    <Border Grid.Row="3"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource ControlBorderBrush}"
                            Background="{DynamicResource ControlBackgroundBrush}"
                            CornerRadius="4"
                            Padding="10">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top"
                                       Text="Library contents"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       Margin="0,0,0,8"/>

                            <ListView x:Name="LibraryContentsListView"
                                      Style="{StaticResource FluentListView}"
                                      SelectionMode="Single">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="App"      DisplayMemberBinding="{Binding Name}"          Width="220"/>
                                        <GridViewColumn Header="Versions" DisplayMemberBinding="{Binding VersionCount}"  Width="80"/>
                                        <GridViewColumn Header="Path"     Width="750">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Path}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}"/>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </DockPanel>
                    </Border>

                    <TextBlock Grid.Row="4"
                               x:Name="LibraryStatusLabel"
                               Text="Select an app row to view versions from library."
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Center"
                               Margin="0,9,0,7"/>

                    <Border Grid.Row="5"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource ControlBorderBrush}"
                            Background="{DynamicResource ControlBackgroundBrush}"
                            CornerRadius="4"
                            Padding="10">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top"
                                       Text="Selected app details"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       Margin="0,0,0,8"/>

                            <ListView x:Name="LibraryDetailsListView"
                                      Style="{StaticResource FluentListView}"
                                      SelectionMode="Single">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="App (Version)"  DisplayMemberBinding="{Binding Version}"      Width="180"/>
                                        <GridViewColumn Header="Architecture"    DisplayMemberBinding="{Binding Architecture}" Width="110"/>
                                        <GridViewColumn Header="Type"            DisplayMemberBinding="{Binding Type}"         Width="80"/>
                                        <GridViewColumn Header="URI"             Width="460">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding URI}" TextTrimming="CharacterEllipsis" ToolTip="{Binding URI}"/>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </DockPanel>
                    </Border>
                </Grid>
            </Grid>

            <!-- Import view -->
            <Grid x:Name="ImportPanel"
                  Visibility="Collapsed"
                  Background="{DynamicResource WindowBackgroundBrush}">
                <Grid Margin="22,18,22,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,12">
                        <TextBlock Text="Import"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   DockPanel.Dock="Left"
                                   VerticalAlignment="Center"/>
                    </DockPanel>

                    <TabControl Grid.Row="1"
                                x:Name="ImportProviderTabControl"
                                Style="{StaticResource FluentTabControl}">

                        <TabItem Header="Microsoft Intune Win32 Apps"
                                 Style="{StaticResource FluentTabItem}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>     <!-- Main split    -->
                                    <RowDefinition Height="Auto"/>  <!-- Action bar    -->
                                </Grid.RowDefinitions>

                                <!-- Unified reconciliation view with definitions toolbar -->
                                <Border Grid.Row="0"
                                        BorderThickness="1"
                                        BorderBrush="{DynamicResource ControlBorderBrush}"
                                        Background="{DynamicResource ControlBackgroundBrush}"
                                        CornerRadius="4"
                                        Margin="0,0,0,12"
                                        ClipToBounds="True">
                                    <DockPanel>

                                        <Border DockPanel.Dock="Top"
                                                BorderBrush="{DynamicResource ControlBorderBrush}"
                                                BorderThickness="0,0,0,1"
                                                Padding="10,8"
                                                Background="{DynamicResource WindowBackgroundBrush}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox x:Name="IntuneDefinitionsPathBox"
                                                         Grid.Column="0"
                                                         Style="{StaticResource FluentTextBox}"
                                                         Margin="0,0,6,0"
                                                         ToolTip="Path to the packagefactory application definitions root folder"/>
                                                <TextBlock Text="Path to package definitions..."
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           IsHitTestVisible="False"
                                                           Margin="10,0,6,0"
                                                           VerticalAlignment="Center"
                                                           FontSize="13"
                                                           Grid.Column="0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Text, ElementName=IntuneDefinitionsPathBox}" Value="">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <Button x:Name="BrowseIntuneDefinitionsButton"
                                                        Grid.Column="1"
                                                        Content="Browse"
                                                        Style="{StaticResource FluentSecondaryButton}"
                                                        Margin="0,0,6,0"
                                                        Padding="10,6"/>
                                                <Button x:Name="IntuneLoadDefinitionsButton"
                                                        Grid.Column="2"
                                                        Content="Load definitions"
                                                        Style="{StaticResource FluentSecondaryButton}"
                                                        Margin="0,0,6,0"
                                                        Padding="10,6"/>
                                                <Button x:Name="IntuneRefreshCatalogButton"
                                                        Grid.Column="3"
                                                        Content="Compare with Intune Win32 apps"
                                                        Style="{StaticResource FluentButton}"
                                                    Padding="10,6"
                                                    IsEnabled="False"/>
                                            </Grid>
                                        </Border>

                                        <Border DockPanel.Dock="Top"
                                                BorderBrush="{DynamicResource ControlBorderBrush}"
                                                BorderThickness="0,0,0,1"
                                                Padding="12,8"
                                                Background="{DynamicResource ControlBackgroundBrush}">
                                            <DockPanel LastChildFill="False">
                                                <StackPanel Orientation="Horizontal"
                                                            VerticalAlignment="Center"
                                                            DockPanel.Dock="Left">
                                                    <TextBlock x:Name="IntuneDefinitionsCountLabel"
                                                               Text="0 loaded"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                               VerticalAlignment="Center"
                                                               Margin="0,0,10,0"/>
                                                    <TextBlock x:Name="IntuneWin32AppsCountLabel"
                                                               Text="0 apps"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                               VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal"
                                                            VerticalAlignment="Center"
                                                            DockPanel.Dock="Right">
                                                    <Ellipse x:Name="IntuneConnectionStatusDot"
                                                             AutomationProperties.Name="Intune connection status"
                                                             Style="{StaticResource StatusDot}"
                                                             Fill="{DynamicResource StatusErrorBrush}"/>
                                                    <TextBlock Text="Intune:"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                               VerticalAlignment="Center"
                                                               Margin="5,0,4,0"/>
                                                    <TextBlock x:Name="IntuneConnectionStatusLabel"
                                                               Text="Not signed in"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                               VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>

                                        <Border x:Name="IntuneImportLoadingPanel"
                                                DockPanel.Dock="Top"
                                                BorderBrush="{DynamicResource ControlBorderBrush}"
                                                BorderThickness="0,0,0,1"
                                                Padding="12,8"
                                                Background="{DynamicResource WindowBackgroundBrush}"
                                                Visibility="Collapsed">
                                            <StackPanel>
                                                <TextBlock x:Name="IntuneImportLoadingLabel"
                                                           Text="Working..."
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           FontSize="11"
                                                           Margin="0,0,0,6"/>
                                                <ProgressBar x:Name="IntuneImportProgressBar"
                                                             IsIndeterminate="True"
                                                             Height="3"
                                                             Foreground="{DynamicResource AccentBrush}"
                                                             Background="{DynamicResource ControlBorderBrush}"
                                                             BorderThickness="0"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Reconciliation list + empty hint -->
                                        <Grid>
                                                <ListView x:Name="IntuneWin32AppsListView"
                                                          Style="{StaticResource FluentListView}"
                                                          BorderThickness="0"
                                                          SelectionMode="Extended">
                                                    <ListView.Resources>

                                                        <Style x:Key="IntuneActionCellStyle"
                                                               TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource Self}}" Value="Import new app">
                                                                    <Setter Property="Foreground" Value="{DynamicResource StatusPositiveBrush}"/>
                                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource Self}}" Value="Import new version and supersede">
                                                                    <Setter Property="Foreground" Value="{DynamicResource StatusPositiveBrush}"/>
                                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource Self}}" Value="Fix in definition">
                                                                    <Setter Property="Foreground" Value="{DynamicResource StatusWarningBrush}"/>
                                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>

                                                        <DataTemplate x:Key="IntuneActionCellTemplate">
                                                            <TextBlock Text="{Binding ImportAction}" Style="{StaticResource IntuneActionCellStyle}"/>
                                                        </DataTemplate>
                                                    </ListView.Resources>
                                                    <ListView.ItemContainerStyle>
                                                        <Style TargetType="ListViewItem">
                                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                            <Setter Property="MinHeight"                  Value="32"/>
                                                            <Setter Property="Padding"                    Value="0"/>
                                                            <Setter Property="Foreground"                 Value="{DynamicResource TextPrimaryBrush}"/>
                                                            <Setter Property="FocusVisualStyle"           Value="{x:Null}"/>
                                                            <Setter Property="Template">
                                                                <Setter.Value>
                                                                    <ControlTemplate TargetType="ListViewItem">
                                                                        <Border x:Name="bd"
                                                                                Background="Transparent"
                                                                                Padding="{TemplateBinding Padding}">
                                                                            <GridViewRowPresenter Content="{TemplateBinding Content}"
                                                                                                  HorizontalAlignment="Stretch"
                                                                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                                                        </Border>
                                                                        <ControlTemplate.Triggers>
                                                                            <DataTrigger Binding="{Binding UpdateRequired}" Value="No">
                                                                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource StatusPositiveLightBrush}"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding UpdateRequired}" Value="Yes">
                                                                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource StatusWarningLightBrush}"/>
                                                                            </DataTrigger>
                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                <Setter TargetName="bd" Property="Background"
                                                                                        Value="{DynamicResource AccentLightBrush}"/>
                                                                            </Trigger>
                                                                            <Trigger Property="IsSelected" Value="True">
                                                                                <Setter TargetName="bd" Property="Background"
                                                                                        Value="{DynamicResource AccentLightBrush}"/>
                                                                                <Setter Property="Foreground"
                                                                                        Value="{DynamicResource AccentBrush}"/>
                                                                            </Trigger>
                                                                        </ControlTemplate.Triggers>
                                                                    </ControlTemplate>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </Style>
                                                    </ListView.ItemContainerStyle>
                                                    <ListView.View>
                                                        <GridView>
                                                            <GridViewColumn Header="App"            DisplayMemberBinding="{Binding DisplayName}"    Width="200"/>
                                                            <GridViewColumn Header="Publisher"       DisplayMemberBinding="{Binding DisplayPublisher}" Width="130"/>
                                                            <GridViewColumn Header="Intune Version"  DisplayMemberBinding="{Binding IntuneVersion}"   Width="110"/>
                                                            <GridViewColumn Header="Latest"          DisplayMemberBinding="{Binding DefinitionVersion}" Width="110"/>
                                                            <GridViewColumn Header="Status"          DisplayMemberBinding="{Binding MatchStatus}"     Width="200"/>
                                                            <GridViewColumn Header="Action"          CellTemplate="{StaticResource IntuneActionCellTemplate}" Width="130"/>
                                                        </GridView>
                                                    </ListView.View>
                                                </ListView>
                                                <StackPanel HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            Margin="16">
                                                    <StackPanel.Style>
                                                        <Style TargetType="StackPanel">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasItems, ElementName=IntuneWin32AppsListView}" Value="False">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </StackPanel.Style>
                                                    <TextBlock Text="No reconciliation rows available."
                                                               HorizontalAlignment="Center"
                                                               TextAlignment="Center"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                               FontSize="12"
                                                               FontWeight="SemiBold"
                                                               TextWrapping="Wrap"/>
                                                    <TextBlock Text="Load definitions and list Win32 apps to build a unified reconciliation view."
                                                               HorizontalAlignment="Center"
                                                               TextAlignment="Center"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                               FontSize="11"
                                                               TextWrapping="Wrap"
                                                               Margin="0,6,0,0"/>
                                                </StackPanel>
                                        </Grid>

                                    </DockPanel>
                                </Border>

                                <!-- Action bar -->
                                <Border Grid.Row="1"
                                        BorderThickness="1"
                                        BorderBrush="{DynamicResource ControlBorderBrush}"
                                        Background="{DynamicResource ControlBackgroundBrush}"
                                        CornerRadius="4"
                                        Padding="12,10">
                                    <DockPanel LastChildFill="True">
                                        <StackPanel Orientation="Horizontal"
                                                    DockPanel.Dock="Right">
                                            <Button x:Name="IntuneApplyImportButton"
                                                    Content="Import Win32 app"
                                                    Style="{StaticResource FluentButton}"
                                                    Height="32"
                                                    Padding="12,0"
                                                    IsEnabled="False"/>
                                        </StackPanel>
                                        <TextBlock x:Name="IntuneActionStatusLabel"
                                                   Text=""
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center"
                                                   FontSize="12"/>
                                    </DockPanel>
                                </Border>

                            </Grid>
                        </TabItem>

                        <TabItem Header="Nerdio Manager Shell Apps"
                                 Style="{StaticResource FluentTabItem}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0"
                                        BorderThickness="1"
                                        BorderBrush="{DynamicResource ControlBorderBrush}"
                                        Background="{DynamicResource ControlBackgroundBrush}"
                                        CornerRadius="4"
                                        Margin="0,0,0,12"
                                        ClipToBounds="True">
                                    <DockPanel>

                                        <Border DockPanel.Dock="Top"
                                                BorderBrush="{DynamicResource ControlBorderBrush}"
                                                BorderThickness="0,0,0,1"
                                                Padding="10,8"
                                                Background="{DynamicResource WindowBackgroundBrush}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox x:Name="NerdioDefinitionsPathBox"
                                                         Grid.Column="0"
                                                         Style="{StaticResource FluentTextBox}"
                                                         Margin="0,0,6,0"/>
                                                <TextBlock Text="Path to Shell App definitions..."
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           IsHitTestVisible="False"
                                                           Margin="10,0,6,0"
                                                           VerticalAlignment="Center"
                                                           FontSize="13"
                                                           Grid.Column="0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Text, ElementName=NerdioDefinitionsPathBox}" Value="">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <Button x:Name="BrowseNerdioDefinitionsButton"
                                                        Grid.Column="1"
                                                        Content="Browse"
                                                        Style="{StaticResource FluentSecondaryButton}"
                                                        Margin="0,0,6,0"
                                                        Padding="10,6"/>
                                                <Button x:Name="NerdioLoadDefinitionsButton"
                                                        Grid.Column="2"
                                                        Content="Load definitions"
                                                        Style="{StaticResource FluentSecondaryButton}"
                                                    Padding="10,6"
                                                    Margin="0,0,6,0"/>
                                                <Button x:Name="NerdioListShellAppsButton"
                                                    Grid.Column="3"
                                                    Content="Compare with Shell Apps"
                                                    Style="{StaticResource FluentButton}"
                                                    Padding="10,6"
                                                    IsEnabled="False"/>
                                            </Grid>
                                        </Border>

                                        <Border DockPanel.Dock="Top"
                                                BorderBrush="{DynamicResource ControlBorderBrush}"
                                                BorderThickness="0,0,0,1"
                                                Padding="12,8"
                                                Background="{DynamicResource ControlBackgroundBrush}">
                                            <DockPanel LastChildFill="False">
                                                <StackPanel Orientation="Horizontal"
                                                            VerticalAlignment="Center"
                                                            DockPanel.Dock="Left">
                                                    <TextBlock x:Name="NerdioDefinitionsCountLabel"
                                                               Text="0 definitions"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                               VerticalAlignment="Center"
                                                               Margin="0,0,10,0"/>
                                                    <TextBlock x:Name="NerdioShellAppsCountLabel"
                                                               Text="0 apps"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                               VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal"
                                                            VerticalAlignment="Center"
                                                            DockPanel.Dock="Right">
                                                    <Ellipse x:Name="NerdioImportAuthStatusDot"
                                                             AutomationProperties.Name="Nerdio import authentication status"
                                                             Style="{StaticResource StatusDot}"
                                                             Fill="{DynamicResource StatusErrorBrush}"/>
                                                    <TextBlock Text="Nerdio Manager:"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                               VerticalAlignment="Center"
                                                               FontSize="11"
                                                               Margin="5,0,4,0"/>
                                                    <TextBlock x:Name="NerdioImportAuthStatusLabel"
                                                               Text="Not signed in"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                               VerticalAlignment="Center"
                                                               FontSize="11"/>
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>

                                        <Border x:Name="NerdioShellAppsLoadingPanel"
                                                DockPanel.Dock="Top"
                                                BorderBrush="{DynamicResource ControlBorderBrush}"
                                                BorderThickness="0,0,0,1"
                                                Padding="12,8"
                                                Background="{DynamicResource WindowBackgroundBrush}"
                                                Visibility="Collapsed">
                                            <StackPanel>
                                                <TextBlock x:Name="NerdioShellAppsLoadingLabel"
                                                           Text="Loading Shell Apps from Nerdio Manager..."
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           FontSize="11"
                                                           Margin="0,0,0,6"/>
                                                <ProgressBar x:Name="NerdioShellAppsProgressBar"
                                                             IsIndeterminate="True"
                                                             Height="3"
                                                             Foreground="{DynamicResource AccentBrush}"
                                                             Background="{DynamicResource ControlBorderBrush}"
                                                             BorderThickness="0"/>
                                            </StackPanel>
                                        </Border>

                                        <Grid>
                                            <ListView x:Name="NerdioDefinitionsListView"
                                                      Style="{StaticResource FluentListView}"
                                                      BorderThickness="0"
                                                      SelectionMode="Single">
                                                <ListView.Resources>

                                                    <Style x:Key="NerdioStatusCellStyle"
                                                           TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource Self}}" Value="Matched (update available)">
                                                                <Setter Property="Foreground" Value="{DynamicResource StatusPositiveBrush}"/>
                                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource Self}}" Value="Matched (compare unavailable)">
                                                                <Setter Property="Foreground" Value="{DynamicResource StatusWarningBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource Self}}" Value="Duplicate matches">
                                                                <Setter Property="Foreground" Value="{DynamicResource StatusErrorBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource Self}}" Value="Invalid definition">
                                                                <Setter Property="Foreground" Value="{DynamicResource StatusErrorBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource Self}}" Value="Unsupported source type">
                                                                <Setter Property="Foreground" Value="{DynamicResource StatusErrorBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>

                                                    <DataTemplate x:Key="NerdioStatusCellTemplate">
                                                        <TextBlock Text="{Binding MatchStatus}" Style="{StaticResource NerdioStatusCellStyle}" TextTrimming="CharacterEllipsis" ToolTip="{Binding MatchStatus}"/>
                                                    </DataTemplate>

                                                    <Style x:Key="NerdioActionCellStyle"
                                                           TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource Self}}" Value="Update">
                                                                <Setter Property="Foreground" Value="{DynamicResource StatusPositiveBrush}"/>
                                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource Self}}" Value="Import">
                                                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>

                                                    <DataTemplate x:Key="NerdioActionCellTemplate">
                                                        <TextBlock Text="{Binding Action}" Style="{StaticResource NerdioActionCellStyle}"/>
                                                    </DataTemplate>
                                                </ListView.Resources>
                                                <ListView.ItemContainerStyle>
                                                    <Style TargetType="ListViewItem">
                                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                        <Setter Property="MinHeight"                  Value="32"/>
                                                        <Setter Property="Padding"                    Value="0"/>
                                                        <Setter Property="Foreground"                 Value="{DynamicResource TextPrimaryBrush}"/>
                                                        <Setter Property="FocusVisualStyle"           Value="{x:Null}"/>
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="ListViewItem">
                                                                    <Border x:Name="bd"
                                                                            Background="Transparent"
                                                                            Padding="{TemplateBinding Padding}">
                                                                        <GridViewRowPresenter Content="{TemplateBinding Content}"
                                                                                              HorizontalAlignment="Stretch"
                                                                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <DataTrigger Binding="{Binding Action}" Value="Update">
                                                                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource StatusWarningLightBrush}"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Action}" Value="Import">
                                                                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource StatusPositiveLightBrush}"/>
                                                                        </DataTrigger>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentLightBrush}"/>
                                                                        </Trigger>
                                                                        <Trigger Property="IsSelected" Value="True">
                                                                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentLightBrush}"/>
                                                                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </ListView.ItemContainerStyle>
                                                <ListView.View>
                                                    <GridView>
                                                        <GridViewColumn Header="App"               Width="155">
                                                            <GridViewColumn.CellTemplate>
                                                                <DataTemplate>
                                                                    <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" ToolTip="{Binding DisplayName}"/>
                                                                </DataTemplate>
                                                            </GridViewColumn.CellTemplate>
                                                        </GridViewColumn>
                                                        <GridViewColumn Header="Publisher"          DisplayMemberBinding="{Binding Publisher}"        Width="130"/>
                                                        <GridViewColumn Header="Shell App"          Width="165">
                                                            <GridViewColumn.CellTemplate>
                                                                <DataTemplate>
                                                                    <TextBlock Text="{Binding NerdioAppName}" TextTrimming="CharacterEllipsis" ToolTip="{Binding NerdioAppName}"/>
                                                                </DataTemplate>
                                                            </GridViewColumn.CellTemplate>
                                                        </GridViewColumn>
                                                        <GridViewColumn Header="Versions"           DisplayMemberBinding="{Binding VersionCount}"     Width="75"/>
                                                        <GridViewColumn Header="Shell App Version"  DisplayMemberBinding="{Binding NerdioVersion}"    Width="115"/>
                                                        <GridViewColumn Header="Latest"             DisplayMemberBinding="{Binding EvergreenVersion}" Width="115"/>
                                                        <GridViewColumn Header="Status"             CellTemplate="{StaticResource NerdioStatusCellTemplate}" Width="200"/>
                                                        <GridViewColumn Header="Action"             CellTemplate="{StaticResource NerdioActionCellTemplate}" Width="80"/>
                                                    </GridView>
                                                </ListView.View>
                                            </ListView>
                                            <StackPanel HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        Margin="16">
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasItems, ElementName=NerdioDefinitionsListView}" Value="False">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>
                                                <TextBlock Text="No Nerdio Shell App data loaded."
                                                           HorizontalAlignment="Center"
                                                           TextAlignment="Center"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           TextWrapping="Wrap"/>
                                                <TextBlock Text="Load local definitions and list Shell Apps to build a merged reconciliation view."
                                                           HorizontalAlignment="Center"
                                                           TextAlignment="Center"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           FontSize="11"
                                                           TextWrapping="Wrap"
                                                           Margin="0,6,0,0"/>
                                            </StackPanel>
                                        </Grid>

                                    </DockPanel>
                                </Border>

                                <Border Grid.Row="1"
                                        BorderThickness="1"
                                        BorderBrush="{DynamicResource ControlBorderBrush}"
                                        Background="{DynamicResource ControlBackgroundBrush}"
                                        CornerRadius="4"
                                        Padding="12,10">
                                    <DockPanel LastChildFill="True">
                                        <StackPanel Orientation="Horizontal"
                                                    DockPanel.Dock="Right">
                                            <Button x:Name="NerdioAddVersionButton"
                                                    Content="Add new version to existing Shell App"
                                                    Style="{StaticResource FluentSecondaryButton}"
                                                    Padding="12,6"
                                                    IsEnabled="False"
                                                    Margin="0,0,8,0"/>
                                            <Button x:Name="NerdioImportNewButton"
                                                    Content="Import Shell App"
                                                    Style="{StaticResource FluentButton}"
                                                    Padding="12,6"
                                                    IsEnabled="False"
                                                    ToolTip="This feature is planned for a future release."/>
                                        </StackPanel>
                                        <TextBlock x:Name="NerdioActionStatusLabel"
                                                   Text=""
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center"
                                                   FontSize="12"/>
                                    </DockPanel>
                                </Border>

                            </Grid>
                        </TabItem>

                        <!-- ── Microsoft 365 Apps tab ── -->
                        <TabItem Header="Microsoft 365 Apps"
                                 Style="{StaticResource FluentTabItem}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0"
                                        BorderThickness="1"
                                        BorderBrush="{DynamicResource ControlBorderBrush}"
                                        Background="{DynamicResource ControlBackgroundBrush}"
                                        CornerRadius="4"
                                        Margin="0,0,0,12"
                                        ClipToBounds="True">
                                    <DockPanel>

                                        <!-- Path input and load buttons -->
                                        <Border DockPanel.Dock="Top"
                                                BorderBrush="{DynamicResource ControlBorderBrush}"
                                                BorderThickness="0,0,0,1"
                                                Padding="10,8"
                                                Background="{DynamicResource WindowBackgroundBrush}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox x:Name="M365ConfigPathBox"
                                                         Grid.Column="0"
                                                         Style="{StaticResource FluentTextBox}"
                                                         Margin="0,0,6,0"/>
                                                <TextBlock Text="Path to M365 App configuration files..."
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           IsHitTestVisible="False"
                                                           Margin="10,0,6,0"
                                                           VerticalAlignment="Center"
                                                           FontSize="13"
                                                           Grid.Column="0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Text, ElementName=M365ConfigPathBox}" Value="">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <Button x:Name="BrowseM365ConfigButton"
                                                        Grid.Column="1"
                                                        Content="Browse"
                                                        Style="{StaticResource FluentSecondaryButton}"
                                                        Margin="0,0,6,0"
                                                        Padding="10,6"/>
                                                <Button x:Name="M365LoadConfigsButton"
                                                        Grid.Column="2"
                                                        Content="Load configurations"
                                                        Style="{StaticResource FluentButton}"
                                                        Padding="10,6"/>
                                            </Grid>
                                        </Border>

                                        <!-- Count and version status -->
                                        <Border DockPanel.Dock="Top"
                                                BorderBrush="{DynamicResource ControlBorderBrush}"
                                                BorderThickness="0,0,0,1"
                                                Padding="12,8"
                                                Background="{DynamicResource ControlBackgroundBrush}">
                                            <DockPanel LastChildFill="False">
                                                <TextBlock x:Name="M365ConfigsCountLabel"
                                                           Text="0 configurations"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           VerticalAlignment="Center"
                                                           DockPanel.Dock="Left"/>
                                                <StackPanel Orientation="Horizontal"
                                                            VerticalAlignment="Center"
                                                            DockPanel.Dock="Right">
                                                    <Ellipse x:Name="M365IntuneAuthStatusDot"
                                                             AutomationProperties.Name="Microsoft 365 Intune authentication status"
                                                             Style="{StaticResource StatusDot}"
                                                             Fill="{DynamicResource StatusErrorBrush}"/>
                                                    <TextBlock Text="Intune:"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                               VerticalAlignment="Center"
                                                               FontSize="11"
                                                               Margin="5,0,4,0"/>
                                                    <TextBlock x:Name="M365IntuneAuthStatusLabel"
                                                               Text="Not signed in"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                               VerticalAlignment="Center"
                                                               FontSize="11"
                                                               Margin="0,0,16,0"/>
                                                    <Ellipse x:Name="M365NerdioAuthStatusDot"
                                                             AutomationProperties.Name="Microsoft 365 Nerdio authentication status"
                                                             Style="{StaticResource StatusDot}"
                                                             Fill="{DynamicResource StatusErrorBrush}"/>
                                                    <TextBlock Text="Nerdio Manager:"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                               VerticalAlignment="Center"
                                                               FontSize="11"
                                                               Margin="5,0,4,0"/>
                                                    <TextBlock x:Name="M365NerdioAuthStatusLabel"
                                                               Text="Not connected"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                               VerticalAlignment="Center"
                                                               FontSize="11"/>
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>

                                        <!-- Loading panel -->
                                        <Border x:Name="M365ConfigsLoadingPanel"
                                                DockPanel.Dock="Top"
                                                BorderBrush="{DynamicResource ControlBorderBrush}"
                                                BorderThickness="0,0,0,1"
                                                Padding="12,8"
                                                Background="{DynamicResource WindowBackgroundBrush}"
                                                Visibility="Collapsed">
                                            <StackPanel>
                                                <TextBlock x:Name="M365ConfigsLoadingLabel"
                                                           Text="Loading..."
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           FontSize="11"
                                                           Margin="0,0,0,6"/>
                                                <ProgressBar x:Name="M365ConfigsProgressBar"
                                                             IsIndeterminate="True"
                                                             Height="3"
                                                             Foreground="{DynamicResource AccentBrush}"
                                                             Background="{DynamicResource ControlBorderBrush}"
                                                             BorderThickness="0"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Configurations list -->
                                        <Grid>
                                            <ListView x:Name="M365ConfigsListView"
                                                      Style="{StaticResource FluentListView}"
                                                      BorderThickness="0"
                                                      SelectionMode="Single">
                                                <ListView.Resources>

                                                    <Style x:Key="M365StatusCellStyle"
                                                           TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource Self}}" Value="Valid">
                                                                <Setter Property="Foreground" Value="{DynamicResource StatusPositiveBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource Self}}" Value="No ID">
                                                                <Setter Property="Foreground" Value="{DynamicResource StatusErrorBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource Self}}" Value="Invalid ID">
                                                                <Setter Property="Foreground" Value="{DynamicResource StatusErrorBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource Self}}" Value="Invalid XML">
                                                                <Setter Property="Foreground" Value="{DynamicResource StatusErrorBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>

                                                    <DataTemplate x:Key="M365StatusCellTemplate">
                                                        <TextBlock Text="{Binding Status}" Style="{StaticResource M365StatusCellStyle}"/>
                                                    </DataTemplate>
                                                </ListView.Resources>
                                                <ListView.ItemContainerStyle>
                                                    <Style TargetType="ListViewItem">
                                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                        <Setter Property="MinHeight"                  Value="32"/>
                                                        <Setter Property="Padding"                    Value="0"/>
                                                        <Setter Property="Foreground"                 Value="{DynamicResource TextPrimaryBrush}"/>
                                                        <Setter Property="FocusVisualStyle"           Value="{x:Null}"/>
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="ListViewItem">
                                                                    <Border x:Name="bd"
                                                                            Background="Transparent"
                                                                            Padding="{TemplateBinding Padding}">
                                                                        <GridViewRowPresenter Content="{TemplateBinding Content}"
                                                                                              HorizontalAlignment="Stretch"
                                                                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <DataTrigger Binding="{Binding Status}" Value="Valid">
                                                                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource StatusPositiveLightBrush}"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Status}" Value="No ID">
                                                                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource StatusErrorLightBrush}"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Status}" Value="Invalid XML">
                                                                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource StatusErrorLightBrush}"/>
                                                                        </DataTrigger>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentLightBrush}"/>
                                                                        </Trigger>
                                                                        <Trigger Property="IsSelected" Value="True">
                                                                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentLightBrush}"/>
                                                                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </ListView.ItemContainerStyle>
                                                <ListView.View>
                                                    <GridView>
                                                        <GridViewColumn Header="Filename"     DisplayMemberBinding="{Binding FileName}"         Width="180"/>
                                                        <GridViewColumn Header="Display Name" DisplayMemberBinding="{Binding DisplayName}"      Width="320"/>
                                                        <GridViewColumn Header="Products"     DisplayMemberBinding="{Binding Products}"         Width="220"/>
                                                        <GridViewColumn Header="Status"       CellTemplate="{StaticResource M365StatusCellTemplate}" Width="90"/>
                                                    </GridView>
                                                </ListView.View>
                                            </ListView>
                                            <StackPanel HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        Margin="16">
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasItems, ElementName=M365ConfigsListView}" Value="False">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>
                                                <TextBlock Text="No M365 configurations loaded."
                                                           HorizontalAlignment="Center"
                                                           TextAlignment="Center"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           TextWrapping="Wrap"/>
                                                <TextBlock Text="Browse to your configuration directory and click Load configurations."
                                                           HorizontalAlignment="Center"
                                                           TextAlignment="Center"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           FontSize="11"
                                                           TextWrapping="Wrap"
                                                           Margin="0,6,0,0"/>
                                            </StackPanel>
                                        </Grid>

                                    </DockPanel>
                                </Border>

                                <!-- Action buttons bar -->
                                <Border Grid.Row="1"
                                        BorderThickness="1"
                                        BorderBrush="{DynamicResource ControlBorderBrush}"
                                        Background="{DynamicResource ControlBackgroundBrush}"
                                        CornerRadius="4"
                                        Padding="12,10">
                                    <DockPanel LastChildFill="True">
                                        <StackPanel Orientation="Horizontal"
                                                    DockPanel.Dock="Right">
                                            <Button x:Name="M365ImportNerdioButton"
                                                    Content="Import Nerdio Manager Shell App"
                                                    Style="{StaticResource FluentSecondaryButton}"
                                                    Height="32"
                                                    Padding="12,0"
                                                    IsEnabled="False"
                                                    Margin="0,0,8,0"/>
                                            <Button x:Name="M365ImportIntuneButton"
                                                    Content="Import Intune Win32App"
                                                    Style="{StaticResource FluentButton}"
                                                    Height="32"
                                                    Padding="12,0"
                                                    IsEnabled="False"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal"
                                                    DockPanel.Dock="Left"
                                                    VerticalAlignment="Center">
                                            <TextBlock Text="Channel"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,6,0"/>
                                            <ComboBox x:Name="M365ChannelCombo"
                                                      Style="{StaticResource FluentComboBox}"
                                                      Width="180"
                                                      Height="32"
                                                      Margin="0,0,8,0">
                                                <ComboBoxItem Content="BetaChannel"/>
                                                <ComboBoxItem Content="CurrentPreview"/>
                                                <ComboBoxItem Content="Current"/>
                                                <ComboBoxItem Content="MonthlyEnterprise"/>
                                                <ComboBoxItem Content="PerpetualVL2021"/>
                                                <ComboBoxItem Content="SemiAnnualPreview"/>
                                                <ComboBoxItem Content="SemiAnnual"/>
                                                <ComboBoxItem Content="PerpetualVL2019"/>
                                            </ComboBox>
                                            <TextBlock x:Name="M365EvergreenVersionLabel"
                                                       Text="-"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,16,0"/>
                                            <TextBlock Text="Company name"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,6,0"/>
                                            <TextBox x:Name="M365CompanyNameBox"
                                                     Style="{StaticResource FluentTextBox}"
                                                     Width="200"
                                                     Height="32"/>
                                        </StackPanel>
                                        <TextBlock x:Name="M365ActionStatusLabel"
                                                   Text=""
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center"
                                                   FontSize="12"
                                                   Margin="16,0,0,0"/>
                                    </DockPanel>
                                </Border>

                            </Grid>
                        </TabItem>

                        <!-- ── Authentication tab ── -->
                        <TabItem Header="Authentication"
                                 Style="{StaticResource FluentTabItem}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          Padding="0,2,0,0">
                                <StackPanel>

                                    <!-- Entra ID (Intune) section -->
                                    <TextBlock Text="Entra ID"
                                               FontWeight="SemiBold"
                                               FontSize="13"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               Margin="0,0,0,8"/>
                                    <Border BorderThickness="1"
                                            BorderBrush="{DynamicResource ControlBorderBrush}"
                                            Background="{DynamicResource ControlBackgroundBrush}"
                                            CornerRadius="8"
                                            Padding="12"
                                            Margin="0,0,0,20">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="290"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                       Text="Entra ID sign-in"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,12,0"/>
                                            <TextBox x:Name="ImportTenantIdBox"
                                                     Grid.Column="1"
                                                     Style="{StaticResource FluentTextBox}"
                                                     VerticalAlignment="Center"
                                                     ToolTip="Optional Entra tenant ID for Intune Graph workflows"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="Tenant ID (optional)"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       IsHitTestVisible="False"
                                                       Margin="10,0,0,0"
                                                       VerticalAlignment="Center"
                                                       FontSize="12">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Text, ElementName=ImportTenantIdBox}" Value="">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <StackPanel Grid.Column="3"
                                                        Orientation="Horizontal"
                                                        VerticalAlignment="Center">
                                                <Ellipse x:Name="ImportAuthStatusDot"
                                                         AutomationProperties.Name="Import authentication status"
                                                         Style="{StaticResource StatusDot}"
                                                         Fill="{DynamicResource ControlBorderBrush}"/>
                                                <TextBlock x:Name="ImportAuthStatusLabel"
                                                           Text="Not signed in"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           FontSize="12"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,8,0"/>
                                            </StackPanel>
                                            <Button x:Name="ImportSignInButton"
                                                    Grid.Column="4"
                                                    Content="Sign in"
                                                    Style="{StaticResource FluentButton}"
                                                    Padding="14,6"
                                                    Margin="0,0,8,0"/>
                                            <Button x:Name="ImportSignOutButton"
                                                    Grid.Column="5"
                                                    Content="Sign out"
                                                    Style="{StaticResource FluentSecondaryButton}"
                                                    Padding="14,6"
                                                    IsEnabled="False"/>
                                        </Grid>
                                    </Border>

                                    <!-- Nerdio Manager API section -->
                                    <TextBlock Text="Nerdio Manager API"
                                               FontWeight="SemiBold"
                                               FontSize="13"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               Margin="0,0,0,8"/>
                                    <Border BorderThickness="1"
                                            BorderBrush="{DynamicResource ControlBorderBrush}"
                                            Background="{DynamicResource ControlBackgroundBrush}"
                                            CornerRadius="8"
                                            Padding="14"
                                            Margin="0,0,0,20">
                                        <StackPanel>

                                            <!-- API credential fields -->
                                            <Grid Margin="0,0,0,12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                                    <TextBlock Text="NME Host"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                               FontSize="12"
                                                               Margin="0,0,0,4"/>
                                                    <TextBox x:Name="NmeHostBox"
                                                             Style="{StaticResource FluentTextBox}"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                                    <TextBlock Text="Client ID"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                               FontSize="12"
                                                               Margin="0,0,0,4"/>
                                                    <TextBox x:Name="NmeClientIdBox"
                                                             Style="{StaticResource FluentTextBox}"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Margin="0,0,8,0">
                                                    <TextBlock Text="API Scope"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                               FontSize="12"
                                                               Margin="0,0,0,4"/>
                                                    <TextBox x:Name="NmeApiScopeBox"
                                                             Style="{StaticResource FluentTextBox}"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="3" Margin="0,0,8,0">
                                                    <TextBlock Text="OAuth token URL"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                               FontSize="12"
                                                               Margin="0,0,0,4"/>
                                                    <TextBox x:Name="NmeOAuthTokenUrlBox"
                                                             Style="{StaticResource FluentTextBox}"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="4">
                                                    <TextBlock Text="Client Secret"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                               FontSize="12"
                                                               Margin="0,0,0,4"/>
                                                    <PasswordBox x:Name="NmeClientSecretBox"
                                                                 AutomationProperties.Name="Nerdio Manager client secret"
                                                                 Style="{StaticResource FluentPasswordBox}"/>
                                                </StackPanel>
                                            </Grid>

                                            <!-- Tenant ID + API sign-in row -->
                                            <Border BorderThickness="1"
                                                    BorderBrush="{DynamicResource ControlBorderBrush}"
                                                    Background="{DynamicResource WindowBackgroundBrush}"
                                                    CornerRadius="6"
                                                    Padding="10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="290"/>
                                                        <ColumnDefinition Width="16"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0"
                                                               Text="Tenant ID"
                                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                                               FontSize="12"
                                                               FontWeight="SemiBold"
                                                               VerticalAlignment="Center"
                                                               Margin="0,0,8,0"/>
                                                    <Grid Grid.Column="1">
                                                        <TextBox x:Name="NerdioTenantIdBox"
                                                                 Style="{StaticResource FluentTextBox}"
                                                                 VerticalAlignment="Center"
                                                                 ToolTip="Tenant ID shared by Nerdio Manager API sign-in and optional Azure sign-in"/>
                                                        <TextBlock Text="Tenant ID (optional)"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                                   IsHitTestVisible="False"
                                                                   Margin="10,0,0,0"
                                                                   VerticalAlignment="Center"
                                                                   FontSize="12">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Text, ElementName=NerdioTenantIdBox}" Value="">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Grid>
                                                    <StackPanel Grid.Column="4"
                                                                Orientation="Horizontal"
                                                                VerticalAlignment="Center">
                                                        <Ellipse x:Name="NerdioApiAuthStatusDot"
                                                                 AutomationProperties.Name="Nerdio API authentication status"
                                                                 Style="{StaticResource StatusDot}"
                                                                 Fill="{DynamicResource ControlBorderBrush}"/>
                                                        <TextBlock x:Name="NerdioApiAuthStatusLabel"
                                                                   Text="Not signed in"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                                   FontSize="12"
                                                                   VerticalAlignment="Center"
                                                                   Margin="0,0,8,0"/>
                                                    </StackPanel>
                                                    <Button x:Name="NerdioApiSignInButton"
                                                            Grid.Column="5"
                                                            Content="Sign in"
                                                            Style="{StaticResource FluentButton}"
                                                            Padding="12,6"
                                                            Margin="0,0,8,0"/>
                                                    <Button x:Name="NerdioApiSignOutButton"
                                                            Grid.Column="6"
                                                            Content="Sign out"
                                                            Style="{StaticResource FluentSecondaryButton}"
                                                            Padding="12,6"
                                                            IsEnabled="False"/>
                                                </Grid>
                                            </Border>

                                        </StackPanel>
                                    </Border>

                                    <!-- Azure Storage section -->
                                    <TextBlock Text="Azure Storage"
                                               FontWeight="SemiBold"
                                               FontSize="13"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               Margin="0,0,0,8"/>
                                    <Border BorderThickness="1"
                                            BorderBrush="{DynamicResource ControlBorderBrush}"
                                            Background="{DynamicResource ControlBackgroundBrush}"
                                            CornerRadius="8"
                                            Padding="14"
                                            Margin="0,0,0,20">
                                        <StackPanel>

                                            <!-- Storage fields -->
                                            <Grid Margin="0,0,0,12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                                    <TextBlock Text="Subscription ID"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                               FontSize="12"
                                                               Margin="0,0,0,4"/>
                                                    <TextBox x:Name="NmeSubscriptionIdBox"
                                                             Style="{StaticResource FluentTextBox}"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                                    <TextBlock Text="Resource Group"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                               FontSize="12"
                                                               Margin="0,0,0,4"/>
                                                    <ComboBox x:Name="NmeResourceGroupCombo"
                                                              Style="{StaticResource FluentComboBox}"
                                                              Height="32"
                                                              IsEnabled="False"
                                                              ToolTip="Sign in to Azure to populate this list"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Margin="0,0,8,0">
                                                    <TextBlock Text="Storage Account"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                               FontSize="12"
                                                               Margin="0,0,0,4"/>
                                                    <ComboBox x:Name="NmeStorageAccountCombo"
                                                              Style="{StaticResource FluentComboBox}"
                                                              Height="32"
                                                              IsEnabled="False"
                                                              ToolTip="Select a Resource Group first"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="3">
                                                    <TextBlock Text="Container"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                               FontSize="12"
                                                               Margin="0,0,0,4"/>
                                                    <ComboBox x:Name="NmeContainerCombo"
                                                              Style="{StaticResource FluentComboBox}"
                                                              Height="32"
                                                              IsEnabled="False"
                                                              ToolTip="Select a Storage Account first"/>
                                                </StackPanel>
                                            </Grid>

                                            <!-- Azure sign-in row -->
                                            <Border BorderThickness="1"
                                                    BorderBrush="{DynamicResource ControlBorderBrush}"
                                                    Background="{DynamicResource WindowBackgroundBrush}"
                                                    CornerRadius="6"
                                                    Padding="10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="8"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0"
                                                               Text="Azure sign-in (optional)"
                                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                                               FontSize="12"
                                                               FontWeight="SemiBold"
                                                               VerticalAlignment="Center"
                                                               Margin="0,0,10,0"/>
                                                    <StackPanel Grid.Column="2"
                                                                Orientation="Horizontal"
                                                                VerticalAlignment="Center">
                                                        <Ellipse x:Name="NerdioAzureAuthStatusDot"
                                                                 AutomationProperties.Name="Nerdio Azure authentication status"
                                                                 Style="{StaticResource StatusDot}"
                                                                 Fill="{DynamicResource ControlBorderBrush}"/>
                                                        <TextBlock x:Name="NerdioAzureAuthStatusLabel"
                                                                   Text="Not signed in"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                                   FontSize="12"
                                                                   VerticalAlignment="Center"
                                                                   Margin="0,0,8,0"/>
                                                    </StackPanel>
                                                    <Button x:Name="NerdioAzureSignInButton"
                                                            Grid.Column="3"
                                                            Content="Sign in"
                                                            Style="{StaticResource FluentButton}"
                                                            Padding="12,6"
                                                            Margin="0,0,8,0"
                                                            IsEnabled="False"/>
                                                    <Button x:Name="NerdioAzureSignOutButton"
                                                            Grid.Column="4"
                                                            Content="Sign out"
                                                            Style="{StaticResource FluentSecondaryButton}"
                                                            Padding="12,6"
                                                            IsEnabled="False"/>
                                                </Grid>
                                            </Border>

                                        </StackPanel>
                                    </Border>

                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                    </TabControl>
                </Grid>
            </Grid>

            <!-- Install view -->
            <Grid x:Name="InstallPanel"
                  Visibility="Collapsed"
                  Background="{DynamicResource WindowBackgroundBrush}">
                <Grid Margin="22,18,22,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,12">
                        <TextBlock Text="Install"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   DockPanel.Dock="Left"
                                   VerticalAlignment="Center"/>
                    </DockPanel>

                    <Border Grid.Row="1"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource ControlBorderBrush}"
                            Background="{DynamicResource ControlBackgroundBrush}"
                            CornerRadius="4"
                            Margin="0,0,0,12"
                            ClipToBounds="True">
                        <DockPanel>

                            <Border DockPanel.Dock="Top"
                                    BorderBrush="{DynamicResource ControlBorderBrush}"
                                    BorderThickness="0,0,0,1"
                                    Padding="10,8"
                                    Background="{DynamicResource WindowBackgroundBrush}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="InstallDefinitionsPathBox"
                                             Grid.Column="0"
                                             Style="{StaticResource FluentTextBox}"
                                             Margin="0,0,6,0"
                                             ToolTip="Path to package definitions that contain App.json files"/>
                                    <TextBlock Text="Path to package definitions..."
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               IsHitTestVisible="False"
                                               Margin="10,0,6,0"
                                               VerticalAlignment="Center"
                                               FontSize="13"
                                               Grid.Column="0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Text, ElementName=InstallDefinitionsPathBox}" Value="">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <Button x:Name="InstallBrowseDefinitionsButton"
                                            Grid.Column="1"
                                            Content="Browse"
                                            Style="{StaticResource FluentSecondaryButton}"
                                            Margin="0,0,6,0"
                                            Padding="10,6"/>
                                    <Button x:Name="InstallLoadDefinitionsButton"
                                            Grid.Column="2"
                                            Content="Load definitions"
                                            Style="{StaticResource FluentSecondaryButton}"
                                            Margin="0,0,6,0"
                                            Padding="10,6"/>
                                        <Button x:Name="InstallResolveLatestButton"
                                            Grid.Column="3"
                                            Content="Find latest versions"
                                            Style="{StaticResource FluentButton}"
                                            IsEnabled="False"
                                            Padding="10,6"/>
                                </Grid>
                            </Border>

                            <Border DockPanel.Dock="Top"
                                    BorderBrush="{DynamicResource ControlBorderBrush}"
                                    BorderThickness="0,0,0,1"
                                    Padding="12,8"
                                    Background="{DynamicResource ControlBackgroundBrush}">
                                <DockPanel LastChildFill="False">
                                    <StackPanel Orientation="Horizontal"
                                                VerticalAlignment="Center"
                                                Margin="0,0,12,0"
                                                DockPanel.Dock="Left">
                                        <TextBlock x:Name="InstallDefinitionsCountLabel"
                                                   Text="0 loaded"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,10,0"/>
                                        <TextBlock x:Name="InstallActionableCountLabel"
                                                   Text="0 actionable"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal"
                                                VerticalAlignment="Center"
                                                DockPanel.Dock="Right">
                                        <Ellipse x:Name="InstallElevationStatusDot"
                                                 AutomationProperties.Name="Install elevation status"
                                                 Style="{StaticResource StatusDot}"
                                                 Fill="{DynamicResource StatusWarningBrush}"/>
                                        <TextBlock x:Name="InstallElevationStatusLabel"
                                                   Text="Elevation not checked"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <Border x:Name="InstallLoadingPanel"
                                    DockPanel.Dock="Top"
                                    BorderBrush="{DynamicResource ControlBorderBrush}"
                                    BorderThickness="0,0,0,1"
                                    Padding="12,8"
                                    Background="{DynamicResource WindowBackgroundBrush}"
                                    Visibility="Collapsed">
                                <StackPanel>
                                    <TextBlock x:Name="InstallLoadingLabel"
                                               Text="Working..."
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               FontSize="11"
                                               Margin="0,0,0,6"/>
                                    <ProgressBar x:Name="InstallProgressBar"
                                                 IsIndeterminate="True"
                                                 Height="3"
                                                 Foreground="{DynamicResource AccentBrush}"
                                                 Background="{DynamicResource ControlBorderBrush}"
                                                 BorderThickness="0"/>
                                </StackPanel>
                            </Border>

                            <Grid>
                                <ListView x:Name="InstallPackagesListView"
                                          Style="{StaticResource FluentListView}"
                                          BorderThickness="0"
                                          SelectionMode="Extended">
                                    <ListView.ItemContainerStyle>
                                        <Style TargetType="ListViewItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            <Setter Property="MinHeight" Value="32"/>
                                            <Setter Property="Padding" Value="0"/>
                                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListViewItem">
                                                        <Border x:Name="bd"
                                                                Background="Transparent"
                                                                Padding="{TemplateBinding Padding}">
                                                            <GridViewRowPresenter Content="{TemplateBinding Content}"
                                                                                  HorizontalAlignment="Stretch"
                                                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <DataTrigger Binding="{Binding InstallStatus}" Value="Installed (up to date)">
                                                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource StatusPositiveLightBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding InstallStatus}" Value="Installed (update needed)">
                                                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource StatusWarningLightBrush}"/>
                                                            </DataTrigger>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentLightBrush}"/>
                                                            </Trigger>
                                                            <Trigger Property="IsSelected" Value="True">
                                                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentLightBrush}"/>
                                                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListView.ItemContainerStyle>
                                    <ListView.View>
                                        <GridView>
                                            <GridViewColumn Header="App" DisplayMemberBinding="{Binding Name}" Width="190"/>
                                            <GridViewColumn Header="Publisher" DisplayMemberBinding="{Binding Publisher}" Width="140"/>
                                            <GridViewColumn Header="Installed" DisplayMemberBinding="{Binding InstalledVersion}" Width="100"/>
                                            <GridViewColumn Header="Latest" DisplayMemberBinding="{Binding LatestVersion}" Width="100"/>
                                            <GridViewColumn Header="Status" DisplayMemberBinding="{Binding InstallStatus}" Width="170"/>
                                            <GridViewColumn Header="Action" DisplayMemberBinding="{Binding InstallAction}" Width="120"/>
                                        </GridView>
                                    </ListView.View>
                                </ListView>
                                <StackPanel HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Margin="16">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasItems, ElementName=InstallPackagesListView}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock Text="No package definitions loaded for local install."
                                               HorizontalAlignment="Center"
                                               TextAlignment="Center"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap"/>
                                    <TextBlock Text="Load package definitions, find latest versions, then install selected packages."
                                               HorizontalAlignment="Center"
                                               TextAlignment="Center"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               FontSize="11"
                                               TextWrapping="Wrap"
                                               Margin="0,6,0,0"/>
                                </StackPanel>
                            </Grid>

                        </DockPanel>
                    </Border>

                    <Border Grid.Row="2"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource ControlBorderBrush}"
                            Background="{DynamicResource ControlBackgroundBrush}"
                            CornerRadius="4"
                            Padding="12,10">
                        <DockPanel LastChildFill="True">
                            <StackPanel Orientation="Horizontal"
                                        DockPanel.Dock="Right">
                                <Button x:Name="InstallApplyButton"
                                        Content="Install selected"
                                        Style="{StaticResource FluentButton}"
                                        Padding="12,6"
                                        IsEnabled="False"/>
                            </StackPanel>
                            <TextBlock x:Name="InstallActionStatusLabel"
                                       Text=""
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       VerticalAlignment="Center"
                                       FontSize="12"/>
                        </DockPanel>
                    </Border>
                </Grid>
            </Grid>

            <!-- Settings view -->
            <Grid x:Name="SettingsPanel"
                  Visibility="Collapsed"
                  Background="{DynamicResource WindowBackgroundBrush}">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="22,18,22,12" MaxWidth="760" HorizontalAlignment="Left">

                        <TextBlock Text="Settings"
                                   FontSize="20" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   Margin="0,0,0,12"/>

                        <Border BorderThickness="1"
                                BorderBrush="{DynamicResource ControlBorderBrush}"
                                Background="{DynamicResource ControlBackgroundBrush}"
                                CornerRadius="8"
                                Padding="14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="170"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.ColumnSpan="2"
                                           Text="General"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           Margin="0,0,0,14"/>

                                <TextBlock Grid.Row="1" Grid.Column="0"
                                           Text="Download output path"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="12"
                                           Margin="0,7,10,16"/>
                                <DockPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,16">
                                    <Button x:Name="BrowseOutputButton"
                                            Content="Browse"
                                            DockPanel.Dock="Right"
                                            Style="{StaticResource FluentSecondaryButton}"
                                            Width="{Binding ElementName=OpenEvergreenAppsFolderButton, Path=ActualWidth}"
                                            Margin="8,0,0,0"/>
                                    <TextBox x:Name="OutputPathBox"
                                             Style="{StaticResource FluentTextBox}"/>
                                </DockPanel>

                                <TextBlock Grid.Row="2" Grid.Column="0"
                                           Text="Evergreen apps path"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="12"
                                           Margin="0,7,10,16"/>
                                <DockPanel Grid.Row="2" Grid.Column="1" Margin="0,0,0,16">
                                    <Button x:Name="OpenEvergreenAppsFolderButton"
                                            Content="Open folder"
                                            DockPanel.Dock="Right"
                                            Style="{StaticResource FluentSecondaryButton}"
                                            Margin="8,0,0,0"/>
                                    <TextBox x:Name="EvergreenAppsPathBox"
                                             Style="{StaticResource FluentTextBox}"
                                             IsReadOnly="True"
                                             Background="{DynamicResource SecondaryButtonBackgroundBrush}"
                                             Foreground="{DynamicResource TextSecondaryBrush}"
                                             ToolTip="Path returned by Get-EvergreenAppsPath"/>
                                </DockPanel>

                                <TextBlock Grid.Row="3" Grid.Column="0"
                                           Text="Preferences"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="12"
                                           Margin="0,7,10,16"/>
                                <Grid Grid.Row="3" Grid.Column="1" Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="32"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Theme selector (left) -->
                                    <TextBlock Grid.Row="0" Grid.Column="0"
                                               Text="Theme"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               FontSize="12"
                                               Margin="0,0,0,4"/>
                                    <ComboBox x:Name="ThemeComboBox"
                                              Grid.Row="1" Grid.Column="0"
                                              Style="{StaticResource FluentComboBox}"
                                              Height="32">
                                        <ComboBoxItem Content="Light"/>
                                        <ComboBoxItem Content="Dark"/>
                                    </ComboBox>

                                    <!-- Tab visibility toggles (right) -->
                                    <StackPanel Grid.Row="0" Grid.Column="2" Grid.RowSpan="2"
                                                VerticalAlignment="Center">
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                       Text="Show Import tab"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       ToolTip="Enable to display the Import tab in the navigation rail."/>
                                            <ToggleButton x:Name="ShowImportTabToggle"
                                                          AutomationProperties.Name="Show Import tab"
                                                          Grid.Column="1"
                                                          Style="{StaticResource FluentToggleSwitch}"
                                                          VerticalAlignment="Center"
                                                          Margin="16,0,0,0"
                                                          ToolTip="Enable to display the Import tab in the navigation rail."/>
                                        </Grid>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                       Text="Show Install tab"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       ToolTip="Enable to display the Install tab in the navigation rail."/>
                                            <ToggleButton x:Name="ShowInstallTabToggle"
                                                          AutomationProperties.Name="Show Install tab"
                                                          Grid.Column="1"
                                                          Style="{StaticResource FluentToggleSwitch}"
                                                          VerticalAlignment="Center"
                                                          Margin="16,0,0,0"
                                                          ToolTip="Enable to display the Install tab in the navigation rail."/>
                                        </Grid>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Grid.Row="4" Grid.Column="0"
                                           Text="App version cache"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="12"
                                           Margin="0,2,10,0"/>
                                <StackPanel Grid.Row="4" Grid.Column="1">
                                    <TextBlock Text="Cached version data is stored locally and loaded automatically when you select an app. Clear the cache to force a fetch via Evergreen on next selection."
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               FontSize="12"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,8"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="OpenCacheFolderButton"
                                                Content="Open cache folder"
                                                Style="{StaticResource FluentSecondaryButton}"
                                                Margin="0,0,8,0"/>
                                        <Button x:Name="ClearCacheButton"
                                                Content="Clear cache"
                                                Style="{StaticResource FluentSecondaryButton}"/>
                                    </StackPanel>
                                </StackPanel>

                                <TextBlock Grid.Row="5" Grid.Column="0"
                                           Text="Logs"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="12"
                                           Margin="0,14,10,0"/>
                                <StackPanel Grid.Row="5" Grid.Column="1" Margin="0,12,0,0">
                                    <TextBlock Text="Open the EvergreenUI logs folder or clear all local log files (*.log)."
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               FontSize="12"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,8"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="OpenLogsFolderButton"
                                                Content="Open logs folder"
                                                Style="{StaticResource FluentSecondaryButton}"
                                                Margin="0,0,8,0"/>
                                        <Button x:Name="ClearLogsButton"
                                                Content="Clear logs"
                                                Style="{StaticResource FluentSecondaryButton}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border BorderThickness="1"
                                BorderBrush="{DynamicResource ControlBorderBrush}"
                                Background="{DynamicResource ControlBackgroundBrush}"
                                CornerRadius="8"
                                Padding="14"
                                Margin="0,12,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="170"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.ColumnSpan="2"
                                           Text="Microsoft Intune"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           Margin="0,0,0,14"/>

                                <TextBlock Grid.Row="1" Grid.Column="0"
                                           Text="IntuneWin32App module"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="12"
                                           Margin="0,7,10,16"/>
                                <DockPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,16">
                                    <Button x:Name="IntuneReloadModuleSettingsButton"
                                            Content="Reload"
                                            DockPanel.Dock="Right"
                                            Style="{StaticResource FluentSecondaryButton}"
                                            Width="{Binding ElementName=IntuneBrowsePackageOutputButton, Path=ActualWidth}"
                                            Margin="8,0,0,0"/>
                                    <DockPanel VerticalAlignment="Center">
                                        <Ellipse x:Name="IntuneSettingsModuleStatusDot"
                                                 DockPanel.Dock="Left"
                                                 Style="{StaticResource StatusDot}"
                                                 Fill="{DynamicResource ControlBorderBrush}"/>
                                        <TextBlock x:Name="IntuneSettingsModuleStatusLabel"
                                                   Text="Module not checked."
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   FontSize="12"
                                                   VerticalAlignment="Center"
                                                   TextWrapping="Wrap"/>
                                    </DockPanel>
                                </DockPanel>

                                <TextBlock Grid.Row="2" Grid.Column="0"
                                           Text="Package output path"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="12"
                                           Margin="0,7,10,0"/>
                                <DockPanel Grid.Row="2" Grid.Column="1">
                                    <Button x:Name="IntuneBrowsePackageOutputButton"
                                            Content="Browse"
                                            DockPanel.Dock="Right"
                                            Style="{StaticResource FluentSecondaryButton}"
                                            Margin="8,0,0,0"/>
                                    <TextBox x:Name="IntunePackageOutputPathBox"
                                             Style="{StaticResource FluentTextBox}"
                                             ToolTip="Folder where .intunewin packages are written during the Package step"/>
                                </DockPanel>
                            </Grid>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- Update view -->
            <Grid x:Name="UpdatePanel"
                  Visibility="Collapsed"
                  Background="{DynamicResource WindowBackgroundBrush}">
                <Grid Margin="22,18,22,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,12">
                        <TextBlock Text="Update"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   DockPanel.Dock="Left"
                                   VerticalAlignment="Center"/>
                    </DockPanel>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
                        <Button x:Name="RunUpdateEvergreenButton"
                                Content="Run Update-Evergreen"
                                Style="{StaticResource FluentButton}"
                                Padding="12,6"
                                Margin="0,0,8,0"/>
                    </StackPanel>

                    <Border Grid.Row="2"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource ControlBorderBrush}"
                            Background="{DynamicResource ControlBackgroundBrush}"
                            CornerRadius="4"
                            Padding="0">
                        <ScrollViewer x:Name="UpdateOutputScrollViewer"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Auto"
                                      Background="{DynamicResource ControlBackgroundBrush}">
                            <TextBox x:Name="UpdateOutputTextBox"
                                     IsReadOnly="True"
                                     AcceptsReturn="True"
                                     TextWrapping="NoWrap"
                                     FontFamily="Consolas"
                                     FontSize="12"
                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                     Background="{DynamicResource ControlBackgroundBrush}"
                                     BorderThickness="0"
                                     Padding="8,6"
                                     VerticalAlignment="Top"/>
                        </ScrollViewer>
                    </Border>

                    <TextBlock Grid.Row="3"
                               x:Name="UpdateStatusLabel"
                               Text="Ready to run Update-Evergreen."
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Center"
                               Margin="0,9,0,0"/>
                </Grid>
            </Grid>

            <!-- About view -->
            <Grid x:Name="AboutPanel"
                  Visibility="Collapsed"
                  Background="{DynamicResource WindowBackgroundBrush}">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="22,18,22,12" MaxWidth="760" HorizontalAlignment="Left">

                        <TextBlock Text="About"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   Margin="0,0,0,12"/>

                        <Border BorderThickness="1"
                                BorderBrush="{DynamicResource ControlBorderBrush}"
                                Background="{DynamicResource ControlBackgroundBrush}"
                                CornerRadius="8"
                                Padding="14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="170"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Module"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="12" Margin="0,0,10,8"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="AboutNameValue"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           TextWrapping="Wrap" Margin="0,0,0,8"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Version"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="12" Margin="0,0,10,8"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="AboutVersionValue"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           TextWrapping="Wrap" Margin="0,0,0,8"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Prerelease"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="12" Margin="0,0,10,8"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" x:Name="AboutPrereleaseValue"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           TextWrapping="Wrap" Margin="0,0,0,8"/>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Author"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="12" Margin="0,0,10,8"/>
                                <TextBlock Grid.Row="3" Grid.Column="1" x:Name="AboutAuthorValue"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           TextWrapping="Wrap" Margin="0,0,0,8"/>

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Company"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="12" Margin="0,0,10,8"/>
                                <TextBlock Grid.Row="4" Grid.Column="1" x:Name="AboutCompanyValue"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           TextWrapping="Wrap" Margin="0,0,0,8"/>

                                <TextBlock Grid.Row="5" Grid.Column="0" Text="Copyright"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="12" Margin="0,0,10,8"/>
                                <TextBlock Grid.Row="5" Grid.Column="1" x:Name="AboutCopyrightValue"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           TextWrapping="Wrap" Margin="0,0,0,8"/>

                                <TextBlock Grid.Row="6" Grid.Column="0" Text="License"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="12" Margin="0,0,10,8"/>
                                <TextBlock Grid.Row="6" Grid.Column="1" x:Name="AboutLicenseValue"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           TextWrapping="Wrap" Margin="0,0,0,8"/>

                                <TextBlock Grid.Row="7" Grid.Column="0" Text="Project"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="12" Margin="0,0,10,8"/>
                                <TextBlock Grid.Row="7" Grid.Column="1" x:Name="AboutProjectUriValue"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           TextWrapping="Wrap" Margin="0,0,0,8"/>
                            </Grid>
                        </Border>

                        <Border BorderThickness="1"
                                BorderBrush="{DynamicResource ControlBorderBrush}"
                                Background="{DynamicResource ControlBackgroundBrush}"
                                CornerRadius="8"
                                Padding="14"
                                Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="Description"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           Margin="0,0,0,8"/>
                                <TextBlock x:Name="AboutDescriptionValue"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </Grid>

        </Grid>

        <!-- ══ ROW 2: GridSplitter ═══════════════════════════════════════════════════ -->
        <GridSplitter Grid.Row="2" Grid.ColumnSpan="2"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      Background="{DynamicResource ControlBorderBrush}"
                      ResizeDirection="Rows"
                      ResizeBehavior="PreviousAndNext"
                      ShowsPreview="False"
                      Cursor="SizeNS"/>

        <!-- ══ ROW 3: Status bar + Log panel ═════════════════════════════════════════ -->
        <DockPanel Grid.Row="3" Grid.ColumnSpan="2"
                   LastChildFill="True"
                   Background="{DynamicResource WindowBackgroundBrush}">

            <!-- Status bar - always visible, docked at top of row 3 -->
            <Border DockPanel.Dock="Top"
                    BorderBrush="{DynamicResource ControlBorderBrush}"
                    BorderThickness="0,1,0,1"
                    Height="40"
                    Background="{DynamicResource WindowBackgroundBrush}">
                <DockPanel LastChildFill="False" Margin="12,4">

                    <!-- Log controls (right) -->
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center"
                                DockPanel.Dock="Right">
                        <Button x:Name="CopyLogButton"
                                AutomationProperties.Name="Copy log to clipboard"
                                ToolTip="Copy log to clipboard"
                                Content="Copy log"
                                Style="{StaticResource FluentSecondaryButton}"
                                Padding="10,6"
                                FontSize="12"
                                Margin="0,0,6,0"/>
                        <Button x:Name="SaveLogButton"
                                AutomationProperties.Name="Save log to file"
                                ToolTip="Save log to file"
                                Content="Save log"
                                Style="{StaticResource FluentSecondaryButton}"
                                Padding="10,6"
                                FontSize="12"
                                Margin="0,0,6,0"/>
                        <ToggleButton x:Name="LogToggleButton"
                                      AutomationProperties.Name="Show progress log"
                                      Style="{StaticResource FluentToggleButton}"
                                      Content="Show progress log"
                                      IsChecked="False"
                                      Padding="10,3"
                                      FontSize="12"/>
                    </StackPanel>

                </DockPanel>
            </Border>

            <!-- Log TextBox - fills remainder of row 3 -->
            <ScrollViewer x:Name="LogScrollViewer"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Auto"
                          Background="{DynamicResource ControlBackgroundBrush}">
                <TextBox x:Name="LogTextBox"
                         IsReadOnly="True"
                         AcceptsReturn="True"
                         TextWrapping="NoWrap"
                         FontFamily="Consolas"
                         FontSize="12"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         Background="{DynamicResource ControlBackgroundBrush}"
                         BorderThickness="0"
                         Padding="8,6"
                         VerticalAlignment="Top"/>
            </ScrollViewer>

        </DockPanel>
    </Grid>
</Window>
