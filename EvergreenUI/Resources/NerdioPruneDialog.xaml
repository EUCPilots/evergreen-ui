<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Preview Nerdio Shell App version pruning"
        MinWidth="560"
        MaxWidth="920"
        MaxHeight="640"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ThemeMode="System"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <Window.Resources>
        <Style x:Key="NerdioPruneCardStyle" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast)}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="NerdioPruneFooterStyle" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="{DynamicResource LayerFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="0,1,0,0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast)}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="24,20,24,0">
            <TextBlock Text="Preview version pruning"
                       FontSize="20"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap" />
            <Grid Margin="0,16,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Label Target="{Binding ElementName=NerdioPruneRetentionBox}"
                       Padding="0"
                       VerticalAlignment="Center">
                    <TextBlock x:Name="NerdioPruneRetentionText" TextWrapping="Wrap" />
                </Label>
                <TextBox x:Name="NerdioPruneRetentionBox"
                         Grid.Column="1"
                         Text="1"
                         Width="64"
                         Margin="8,0,0,0"
                         AutomationProperties.Name="Number of newest versions to keep" />
            </Grid>
            <TextBlock x:Name="NerdioPruneHelpText"
                       Text="Select apps explicitly. The preview lists every exact version to retain or delete."
                       TextWrapping="Wrap"
                       Margin="0,0,0,8"
                       AutomationProperties.LiveSetting="Polite" />
        </StackPanel>
        <ScrollViewer x:Name="NerdioPruneScrollViewer"
                      Grid.Row="1"
                      Margin="24,0,24,16"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Focusable="True"
                      AutomationProperties.Name="Shell App version plans">
            <StackPanel x:Name="NerdioPrunePlansPanel" />
        </ScrollViewer>
        <Border Grid.Row="2"
                Style="{StaticResource NerdioPruneFooterStyle}"
                Padding="24,14">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelNerdioPruneButton"
                        Content="Cancel"
                        IsCancel="True"
                        MinWidth="100"
                        Padding="14,6"
                        Margin="0,0,8,0" />
                <Button x:Name="ReviewNerdioPruneButton"
                        Content="Review selected deletions"
                        Style="{DynamicResource AccentButtonStyle}"
                        Padding="14,6" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
